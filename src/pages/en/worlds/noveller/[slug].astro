---
import Layout from '../../../../layouts/Layout.astro';
import NovelReader from '../../../../components/NovelReader.astro';
import {getNovels} from '../../../../lib/novels.js';
export function getStaticPaths(){
  return getNovels('en').map(novel=>({params:{slug:novel.slug},props:{novel}}));
}
const {novel}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const image=novel.cover?base+'/images/'+novel.cover:null;
const alternate=novel.companionSlug?'/varldar/noveller/'+novel.companionSlug+'/':null;
const schema={'@context':'https://schema.org','@type':'CreativeWork',name:novel.title,description:novel.description,genre:novel.genre,inLanguage:'en',author:{'@type':'Person',name:'Spiken'},url:new URL(Astro.url.pathname,Astro.site).toString(),datePublished:novel.published||undefined};
---
<Layout title={novel.metaTitle} description={novel.description} lang="en" alternatePath={alternate} socialImage={image} socialImageAlt={novel.coverAlt} publishedAt={novel.published} structuredData={schema}>
  <NovelReader novel={novel} lang="en" />
</Layout>
