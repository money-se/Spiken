---
import Layout from '../../../../layouts/Layout.astro';
import ReviewReader from '../../../../components/ReviewReader.astro';
import {getReviews} from '../../../../lib/reviews.js';
export function getStaticPaths(){return getReviews('en').map(review=>({params:{slug:review.slug},props:{review}}));}
const {review}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const image=base+'/images/'+review.image;
const alternate=review.companionSlug?'/varldar/recensioner/'+review.companionSlug+'/':null;
const schema={'@context':'https://schema.org','@type':'Review',name:review.title,description:review.description,inLanguage:'en',datePublished:review.published||undefined,
 author:{'@type':'Person',name:'Spiken'},itemReviewed:{'@type':'CreativeWork',name:review.subjectTitle,author:review.creator?{'@type':'Person',name:review.creator}:undefined},
 reviewBody:review.text,reviewRating:review.rating!==null?{'@type':'Rating',ratingValue:review.rating,bestRating:5,worstRating:1}:undefined,url:new URL(Astro.url.pathname,Astro.site).toString()};
---
<Layout title={review.metaTitle} description={review.description} lang="en" alternatePath={alternate} socialImage={image} socialImageAlt={review.imageAlt} publishedAt={review.published} structuredData={schema}>
 <ReviewReader review={review} lang="en"/>
</Layout>
