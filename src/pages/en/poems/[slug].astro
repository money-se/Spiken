---
import Layout from '../../../layouts/Layout.astro';
import PoemReader from '../../../components/PoemReader.astro';
import { getPoems } from '../../../lib/poetry.js';
export function getStaticPaths(){
 return getPoems('en').map(poem=>({params:{slug:poem.slug},props:{poem}}));
}
const {poem}=Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageUrl = poem.image ? base+'/images/'+poem.image.replace(/^\/+/, '') : null;
const schema = {
  '@context':'https://schema.org',
  '@type':'CreativeWork',
  name:poem.title,
  headline:poem.title,
  description:poem.description,
  author:{'@type':'Person',name:'Spiken'},
  genre:'Poetry',
  inLanguage:'en',
  datePublished:poem.published || undefined,
  isAccessibleForFree:true,
  image:imageUrl ? new URL(imageUrl,Astro.site).toString() : undefined,
  url:new URL(Astro.url.pathname,Astro.site).toString()
};
const alternatePath=poem.translatedSlug?'/dikter/'+encodeURIComponent(poem.translatedSlug)+'/':null;
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
 {'@type':'ListItem',position:1,name:'Spiken',item:new URL(base+'/en/',Astro.site).toString()},
 {'@type':'ListItem',position:2,name:'Poetry archive',item:new URL(base+'/en/poems/',Astro.site).toString()},
 {'@type':'ListItem',position:3,name:poem.title,item:new URL(Astro.url.pathname,Astro.site).toString()}
]};
---
<Layout title={poem.metaTitle || poem.title + ' – Spiken'} description={poem.description} lang="en" alternatePath={alternatePath} socialImage={imageUrl} socialImageAlt={poem.imageAlt} publishedAt={poem.published} structuredData={[schema,breadcrumb]}>
 <PoemReader poem={poem} lang="en"/>
</Layout>
