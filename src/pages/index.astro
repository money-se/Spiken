---
import Layout from '../layouts/Layout.astro';
import dikter from '../data/dikter.json';
const base = import.meta.env.BASE_URL.replace(/\\/$/, '');
const img = (name) => base + '/images/' + name + '.webp';
const teman = [
  { namn: 'Kärlek', slug: 'karlek', bild: 'kategori-karlek', text: 'För allt som brinner, även när det gör ont.' },
  { namn: 'Sorg', slug: 'sorg', bild: 'kategori-sorg', text: 'För det vi förlorat och aldrig riktigt släpper.' },
  { namn: 'Saknad', slug: 'saknad', bild: 'kategori-saknad', text: 'För människorna och ögonblicken som fattas.' },
  { namn: 'Ensamhet', slug: 'ensamhet', bild: 'kategori-ensamhet', text: 'För tystnaden som följer med oss.' }
];
function temaLink(t) {
  return dikter.some(d => d.tema.toLocaleLowerCase('sv') === t.namn.toLocaleLowerCase('sv'))
    ? base + '/teman/' + t.slug + '/'
    : base + '/dikter/';
}
const senaste = [...dikter].slice(-3).reverse();
---
<Layout title="Spiken – Ord under huden" description="Spiken – dikter om kärlek, sorg, saknad och ensamhet. Ord som skaver, brinner och stannar kvar.">
  <div class="under-huden">
    <section class="uh-hero" aria-labelledby="uh-title">
      <div class="uh-hero-image" style={`background-image:linear-gradient(90deg,#0b0707 0%,rgba(11,7,7,.98) 13%,rgba(11,7,7,.83) 39%,rgba(11,7,7,.08) 76%),url("${img('hero-under-huden')}")`}></div>
      <div class="uh-container uh-hero-inner">
        <div class="uh-hero-copy">
          <p class="uh-overline">SPIKEN · ORD FRÅN UNDERSIDAN</p>
          <h1 id="uh-title">Ord under <em>huden.</em></h1>
          <p class="uh-lead">Dikter om det som skaver, det som brinner, det som saknas – och det som ändå håller oss vid liv.</p>
          <div class="uh-hero-ctas"><a href={base + '/dikter/'} class="uh-primary">Läs dikter <span aria-hidden="true">↗</span></a><a href={base + '/om/'} class="uh-secondary">Om Spiken <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="uh-emblem-wrap" aria-hidden="true"><div class="uh-emblem" style={`background-image:url("${img('spiken-emblem')}")`}></div></div>
      </div>
      <div class="uh-hero-edge uh-container"><span>DET MÄNSKLIGA. DET OBEKVÄMA. DET ÄKTA.</span><span>01 / 03</span></div>
    </section>

    <section class="uh-section uh-themes" aria-labelledby="uh-themes-title">
      <div class="uh-container">
        <div class="uh-heading"><span class="uh-rule"></span><span class="uh-overline">HITTA EN KÄNSLA</span><span class="uh-rule"></span></div>
        <h2 id="uh-themes-title" class="uh-centered">Det finns ord för <em>allt.</em></h2>
        <p class="uh-section-desc">Välj det som känns närmast just nu.</p>
        <div class="uh-theme-grid">
          {teman.map(t => <a class="uh-theme" href={temaLink(t)} aria-label={`Läs dikter om ${t.namn.toLowerCase()}`}>
            <span class="uh-theme-photo" style={`background-image:linear-gradient(0deg,rgba(8,5,5,.91),rgba(8,5,5,.04) 70%),url("${img(t.bild)}")`}></span>
            <span class="uh-theme-content"><span class="uh-theme-name">{t.namn}</span><span class="uh-theme-caption">{t.text}</span><span class="uh-theme-arrow" aria-hidden="true">↗</span></span>
          </a>)}
        </div>
      </div>
    </section>

    <section class="uh-section uh-featured" aria-labelledby="uh-featured-title">
      <div class="uh-container">
        <div class="uh-featured-heading"><div><p class="uh-overline">UR SPIKENS ARKIV</p><h2 id="uh-featured-title">Ord som <em>stannar kvar.</em></h2></div><a class="uh-inline-link" href={base + '/dikter/'}>Alla dikter ↗</a></div>
        {senaste.length > 0
          ? <div class="uh-poem-grid">{senaste.map((d,i) => <a class="uh-poem-card" href={base + '/dikter/' + d.slug + '/'}><span class="uh-poem-count">0{i+1}</span><span class="uh-poem-title">{d.titel}</span><span class="uh-poem-tag">{d.tema}</span><span class="uh-poem-link">Läs dikten ↗</span></a>)}</div>
          : <div class="uh-poem-grid">
              {[1,2,3].map((n) => <div class="uh-poem-card uh-empty" aria-label="Plats reserverad för kommande dikt"><span class="uh-poem-count">0{n}</span><div class="uh-empty-space" aria-hidden="true"></div><span class="uh-future">Plats för en kommande dikt</span></div>)}
            </div>}
        <p class="uh-editorial-note">Här kommer dina egna dikter att få ta plats. Bilder för kommande diktkort läggs in när vi valt rätt texter.</p>
      </div>
    </section>

    <section class="uh-closing" aria-labelledby="uh-close-title">
      <div class="uh-container uh-closing-inner">
        <div class="uh-closing-symbol" style={`background-image:url("${img('spiken-emblem')}")`} aria-hidden="true"></div>
        <p class="uh-overline">DET HÄR ÄR SPIKEN</p>
        <h2 id="uh-close-title">Det som aldrig sades<br /><em>kan fortfarande kännas.</em></h2>
        <a class="uh-inline-link" href={base + '/dikter/'}>Öppna diktarkivet ↗</a>
      </div>
    </section>
  </div>
</Layout>
<style>
.under-huden{--ink:#0c0808;--red:#751b25;--wine:#3d0c14;--cream:#ece3df;--soft:#c9b8b4;color:var(--cream);background:#0b0808;font-family:Georgia,'Times New Roman',serif}
.uh-container{width:min(1180px,calc(100% - 64px));margin-inline:auto}.uh-overline{font:600 11px/1.5 Arial,sans-serif;letter-spacing:.3em;color:#bba6a2;text-transform:uppercase}
.uh-hero{position:relative;isolation:isolate;min-height:670px;background:#080506;overflow:hidden}.uh-hero-image{position:absolute;inset:0;z-index:-1;background-color:#16090c;background-position:center right;background-size:cover}
.uh-hero::after{content:'';position:absolute;inset:auto 0 0;height:130px;background:linear-gradient(transparent,#0b0808);pointer-events:none;z-index:-1}
.uh-hero-inner{min-height:620px;display:flex;align-items:center;gap:35px}.uh-hero-copy{width:min(660px,68%);padding:75px 0 65px}
.uh-hero h1{font-size:clamp(65px,7.5vw,111px);line-height:1.03;font-weight:400;letter-spacing:-.065em;margin:25px 0 28px;color:#f6eeeb;text-wrap:balance}
.uh-hero h1 em,.uh-centered em,.uh-featured h2 em,.uh-closing h2 em{font-weight:400;color:#d0aba6}
.uh-lead{max-width:480px;color:#e4d0cb;font-size:clamp(18px,2vw,23px);line-height:1.65}.uh-hero-ctas{display:flex;gap:13px;flex-wrap:wrap;margin-top:35px}
.uh-primary,.uh-secondary{display:inline-flex;justify-content:space-between;align-items:center;gap:34px;padding:17px 24px;min-width:168px;font:13px Arial,sans-serif;letter-spacing:.045em;transition:background .18s ease,border-color .18s ease}
.uh-primary{background:#751b25;border:1px solid #8e313b;color:#f5e9e6}.uh-secondary{background:#180b0bc7;border:1px solid #917574;color:#eee2df}.uh-primary:hover,.uh-secondary:hover{background:#a0343c;color:white;text-decoration:none}
.uh-emblem-wrap{align-self:flex-end;margin-left:auto;width:125px;padding-bottom:85px;opacity:.9}.uh-emblem{aspect-ratio:1;background-size:contain;background-repeat:no-repeat;background-position:center}
.uh-hero-edge{display:flex;justify-content:space-between;gap:20px;border-top:1px solid #7b42424f;padding:17px 0 26px;font:10px Arial,sans-serif;color:#a78d88;letter-spacing:.16em}
.uh-section{padding:94px 0}.uh-heading{display:flex;align-items:center;gap:28px;justify-content:center}.uh-rule{height:1px;width:70px;background:#67444a}.uh-centered{text-align:center;margin:24px 0 9px;font-size:clamp(41px,5vw,69px)}.uh-section-desc{text-align:center;font:14px Arial,sans-serif;color:#a99996;margin-bottom:42px}
.uh-theme-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.uh-theme{min-height:325px;position:relative;overflow:hidden;border:1px solid #604044;background:#261316}.uh-theme-photo{position:absolute;inset:0;background-size:cover;background-position:center;transition:transform .4s ease}.uh-theme:hover .uh-theme-photo{transform:scale(1.055)}.uh-theme-content{position:absolute;inset:auto 0 0;padding:32px 21px 22px;display:grid;gap:9px}.uh-theme-name{font-size:clamp(28px,2.9vw,41px);font-style:italic}.uh-theme-caption{font:12px/1.55 Arial,sans-serif;color:#e1cac5;max-width:220px}.uh-theme-arrow{font:25px Arial,sans-serif;color:#f0c0b6;justify-self:end}.uh-theme:hover{text-decoration:none;color:#fff}
.uh-featured{background:#120b0d;border-top:1px solid #41242a}.uh-featured-heading{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:35px}.uh-featured h2{font-size:clamp(39px,5vw,67px);margin:13px 0 0}.uh-inline-link{font:14px Arial,sans-serif;border-bottom:1px solid #8b484c;padding-bottom:9px;color:#edd8d3;white-space:nowrap}.uh-inline-link:hover{color:white}
.uh-poem-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.uh-poem-card{min-height:255px;display:flex;flex-direction:column;padding:25px;background:linear-gradient(145deg,#211315,#0f0a0b);border:1px solid #523036}.uh-poem-count{font:12px Arial,sans-serif;color:#a26c71}.uh-poem-title{font-size:30px;margin-top:auto;padding-bottom:15px}.uh-poem-tag{font:12px Arial,sans-serif;color:#b79999}.uh-poem-link{margin-top:30px;font:12px Arial,sans-serif}.uh-empty{background:#110c0d;border-style:dashed;border-color:#4c3538}.uh-empty-space{flex:1}.uh-future{font:12px Arial,sans-serif;color:#8f7779}.uh-editorial-note{font:12px/1.7 Arial,sans-serif;color:#9d8587;margin-top:24px;max-width:620px}
.uh-closing{padding:100px 0 105px;border-top:1px solid #392024;background:radial-gradient(ellipse at center,#291013,#0a0808 70%);text-align:center}.uh-closing-symbol{width:110px;height:110px;background-position:center;background-size:contain;background-repeat:no-repeat;margin:0 auto 22px}.uh-closing h2{font-size:clamp(33px,4.5vw,60px);line-height:1.25;margin:23px auto 31px;max-width:790px}
@media(max-width:960px){.uh-theme-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.uh-hero-copy{width:75%}.uh-emblem-wrap{display:none}.uh-theme{min-height:280px}}
@media(max-width:650px){.uh-container{width:calc(100% - 36px)}.uh-hero{min-height:630px}.uh-hero-image{background-position:67% center;opacity:.8}.uh-hero-inner{min-height:600px;align-items:end}.uh-hero-copy{width:100%;padding:80px 0 90px}.uh-hero h1{font-size:clamp(58px,13vw,78px)}.uh-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#0a0707b0,#0a07071a),linear-gradient(0deg,#0a0707f0,transparent 70%);z-index:-1}.uh-hero-edge{font-size:9px}.uh-section{padding:64px 0}.uh-theme-grid{gap:10px}.uh-theme{min-height:245px}.uh-theme-content{padding:18px 14px}.uh-theme-name{font-size:28px}.uh-theme-caption{font-size:11px}.uh-featured-heading{align-items:start;flex-direction:column}.uh-poem-grid{grid-template-columns:1fr;gap:12px}.uh-poem-card{min-height:175px}.uh-empty{min-height:125px}.uh-closing{padding:70px 0}.uh-hero-ctas{gap:9px}.uh-primary,.uh-secondary{min-width:140px;padding:15px 17px;gap:14px}}
@media(max-width:380px){.uh-theme-grid{grid-template-columns:1fr}.uh-theme{min-height:210px}}
@media(prefers-reduced-motion:reduce){.uh-theme-photo{transition:none}}
</style>
