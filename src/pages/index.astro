---
import Layout from '../layouts/Layout.astro';
import dikter from '../data/dikter.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const teman = [
  { namn: 'Kärlek', slug: 'karlek', rad: 'Begär, närhet och det som bränner.', ikon: '♡' },
  { namn: 'Sorg', slug: 'sorg', rad: 'Förluster, sprickor och det som stannar.', ikon: '✢' },
  { namn: 'Saknad', slug: 'saknad', rad: 'Det som fattas, det som aldrig blev.', ikon: '⌁' },
  { namn: 'Ensamhet', slug: 'ensamhet', rad: 'Att vara ensam bland andra och i sig själv.', ikon: '◌' }
];
const linkFor = (t) => dikter.some(d => d.tema.toLocaleLowerCase('sv') === t.namn.toLocaleLowerCase('sv'))
  ? base + '/teman/' + t.slug + '/' : base + '/dikter/?tema=' + encodeURIComponent(t.namn);
---
<Layout title="Spiken – Det förbjudna arkivet" description="Spikens förbjudna arkiv. Dikter om kärlek, sorg, saknad, ensamhet och allt som inte alltid får sägas högt.">
  <div class="archive-home">
    <section class="archive-hero wrap" aria-labelledby="archive-title">
      <div class="hero-manuscript">
        <span class="paper-corner" aria-hidden="true"></span>
        <span class="stamp mini-stamp">ARKIV / SPIKEN<br/>NR. 0001</span>
        <div class="hero-paper">
          <span class="micro-label">ORD FRÅN UNDERSIDAN · SAMLING 01</span>
          <h1 id="archive-title">SPIKEN<span class="rust">.</span></h1>
          <span class="paint-label">DET FÖRBJUDNA ARKIVET</span>
          <p class="typewriter-intro">En samling dikter, tankar och bekännelser som inte alltid får sägas <span class="underline-red">högt.</span></p>
          <a class="paper-button" href={base + '/dikter/'}>Öppna arkivet <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-collage" aria-hidden="true">
        <div class="portrait-fragment"><span class="portrait-moon"></span><span class="portrait-shadow"></span><span class="portrait-label">Dikter från insidan.</span></div>
        <div class="pressed-flower">
          <svg viewBox="0 0 260 340" fill="none" aria-hidden="true">
            <path d="M132 325L130 65" stroke="#c8ad90" stroke-width="5" stroke-linecap="round"/>
            <path d="M129 230Q70 173 20 211Q83 260 129 230ZM130 269Q177 214 244 242Q192 291 130 269Z" fill="#6e6251" stroke="#8f765d" stroke-width="3"/>
            <path d="M130 119C106 74 56 77 68 120C28 103 24 162 75 168C43 202 91 233 131 190C172 233 217 193 186 166C237 158 228 107 187 119C196 75 154 72 130 119Z" fill="#814739" stroke="#c0846c" stroke-width="3"/>
            <path d="M130 119L131 189M75 168L131 189M187 119L131 189M186 166L131 189M68 120L131 189" stroke="#ad7660" stroke-width="2"/>
            <circle cx="131" cy="151" r="18" fill="#3b2925" stroke="#b07d64" stroke-width="3"/>
            <path d="M123 10H142L139 25H126Z" fill="#9b8c7a"/><path d="M130 25V320L135 330L139 318V25" fill="#978978" stroke="#d5b99a" stroke-width="2"/>
          </svg>
        </div>
        <span class="small-note">LÅT DET SOM SKAVER<br/>FÅ EN PLATS.</span>
      </div>
    </section>

    <section class="themes-section wrap" aria-labelledby="themes-heading">
      <div class="section-marker"><span>01 / FÖRTECKNING</span><span>UTFORSKA EFTER KÄNSLA</span></div>
      <h2 id="themes-heading">Bläddra bland <em>det osagda.</em></h2>
      <div class="archive-themes">
        {teman.map((tema, i) => <a class="archive-theme" href={linkFor(tema)} aria-label={'Dikter om ' + tema.namn.toLowerCase()}>
          <span class="theme-art" aria-hidden="true"><span class="theme-glyph">{tema.ikon}</span><span class="theme-print">SPIKEN / {String(i + 1).padStart(2,'0')}</span></span>
          <span class="theme-paper"><span class="theme-count">MAPP {String(i + 1).padStart(2,'0')}</span><strong>{tema.namn}</strong><span class="theme-text">{tema.rad}</span><span class="theme-arrow" aria-hidden="true">↗</span></span>
        </a>)}
      </div>
    </section>

    <section class="archive-content wrap" aria-labelledby="recent-heading">
      <div class="archive-ledger paper-sheet">
        <div class="ledger-heading"><span class="clip" aria-hidden="true">⌁</span><span class="micro-label ink">REGISTRERADE TEXTER / SPIKEN</span><h2 id="recent-heading">Senast i arkivet</h2></div>
        {dikter.length ? <ol class="ledger-list">{dikter.slice(-5).reverse().map((d, i) => <li><span class="entry-number">№ {String(dikter.length - i).padStart(4,'0')}</span><a href={base + '/dikter/' + d.slug + '/'}><strong>{d.titel}</strong><small>{d.tema} · Läs dikten</small></a><span aria-hidden="true">→</span></li>)}</ol>
        : <div class="ledger-empty"><span class="entry-number">№ 0000</span><p>Arkivet är öppet.<br/>De första dikterna förs snart in.</p><span class="red-mark">UNDER UPPBYGGNAD</span></div>}
        <a href={base + '/dikter/'} class="ledger-more">Visa hela diktarkivet <span aria-hidden="true">↗</span></a>
      </div>
      <aside class="dossier paper-sheet" aria-label="Om arkivet">
        <div class="dossier-top"><span class="stamp">SPIKEN-ARKIVET<br/>BEVARAS FÖR ALLTID</span><span class="dossier-id">AKT 001<br/>ORD / LIV</span></div>
        <div class="botanical-plate" aria-hidden="true"><svg viewBox="0 0 300 230" fill="none"><path d="M151 210C143 150 143 96 151 21M150 165Q101 119 49 147Q92 177 150 165ZM151 127Q194 86 250 115Q215 143 151 127Z" stroke="#444239" stroke-width="3"/><path d="M151 47c-51-47-76 12-30 35-42 8-7 61 30 22 35 40 76-11 34-22 47-25 16-77-34-35Z" stroke="#5e4b40" stroke-width="3" fill="#b7a38a"/><circle cx="151" cy="78" r="13" fill="#7c4737"/></svg></div>
        <div class="dossier-info"><span>KATEGORI:</span><strong>Poetiskt arkiv</strong><span>STATUS:</span><strong class="rust">Öppet</strong><span>UPPHOV:</span><strong>Spiken</strong></div>
        <p class="dossier-quote">Här samlas det som inte passar in. Det som skaver. Det som fortfarande lever.</p>
        <a class="dossier-link" href={base + '/om/'}>Om människan bakom orden ↗</a>
      </aside>
    </section>
    <section class="archive-ending wrap"><span class="ending-star" aria-hidden="true">✳</span><p>Ingenting behöver vara vackert<br/>för att vara <em>värt att bevara.</em></p><span class="micro-label">SPIKEN · ORD FRÅN UNDERSIDAN</span></section>
  </div>
</Layout>
