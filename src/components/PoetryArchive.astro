---
import { getPoems, poemExcerpt } from '../lib/poetry.js';
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const archiveRoot = base + (en ? '/en/poems/' : '/dikter/');
const poems = getPoems(lang);
const labels = en ? {
  kicker:'SPIKEN · WORDS BENEATH THE SKIN',title:'Poetry',titleAccent:'archive.',
  intro:'For everything that stayed beneath the surface. Find a feeling, a title or the words that speak to you.',
  search:'Search the poems',placeholder:'Search titles, feelings or words…',all:'All poems',
  emptyTitle:'A place for words not yet published.',emptyText:'English translations will appear here when they have been carefully prepared and published. In the meantime, you can explore the Swedish original archive.',
  toSwedish:'Explore Swedish poems',count:'poems',read:'Read poem',noMatch:'No poems match your search.',clear:'Show all poems',
  filters:'Browse by feeling'
} : {
  kicker:'SPIKEN · ORD UNDER HUDEN',title:'Dikt',titleAccent:'arkivet.',
  intro:'För allt som aldrig riktigt fick plats i ett samtal. Sök en känsla, en titel eller de ord du behöver läsa just nu.',
  search:'Sök bland dikterna',placeholder:'Sök titel, känsla eller ord…',all:'Alla dikter',
  emptyTitle:'Här får orden snart sin plats.',emptyText:'Arkivet är förberett för dina dikter. Så snart de publiceras kommer de att visas här, med egna lässidor och möjlighet att dela.',
  toSwedish:'',count:'dikter',read:'Läs dikten',noMatch:'Inga dikter matchar din sökning.',clear:'Visa alla dikter',
  filters:'Välj en känsla'
};
const moods = en ? [
  ['Love','Love'],['Longing','Longing'],['Desire','Desire'],['Existence','Existence'],['Heartbreak','Heartbreak'],['Missing','Missing']
] : [
  ['Kärlek','Kärlek'],['Längtan','Längtan'],['Begär','Begär'],['Existens','Existens'],['Hjärtesorg','Hjärtesorg'],['Saknad','Saknad']
];
const image = base + '/images/spiken-arkiv-hero.webp';
const fallbackImage = base + '/images/spiken-3-forfattare.webp';
---
<div class="pa-shell" style={`--pa-image:url("${image}");--pa-fallback:url("${fallbackImage}")`}>
  <section class="pa-intro" aria-labelledby="pa-title">
    <div class="pa-wrap pa-intro-inner">
      <p class="pa-eyebrow">{labels.kicker}</p>
      <h1 id="pa-title">{labels.title}<em>{labels.titleAccent}</em></h1>
      <p class="pa-lead">{labels.intro}</p>
      <a class="pa-hero-link" href="#pa-explore">{en ? "Explore the archive" : "Utforska dikterna"} <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="pa-library" id="pa-explore" aria-label={en ? 'Browse poetry' : 'Utforska dikter'}>
    <div class="pa-wrap">
      
      <div class="pa-mood-gallery" role="group" aria-label={labels.filters}>
        {[
          {sv:'Kärlek',en:'Love',image:'kategori-karlek'},
          {sv:'Längtan',en:'Longing',image:'kategori-sorg'},
          {sv:'Begär',en:'Desire',image:'kategori-begar-v2'},
          {sv:'Existens',en:'Existence',image:'kategori-ensamhet'}
        ].map(m => <button type="button" class="pa-mood-button" data-theme={(en?m.en:m.sv).toLocaleLowerCase(lang)} aria-pressed="false">
          <img src={base+'/images/'+m.image+'.webp'} loading="lazy" alt="" width="520" height="300" />
          <span>{en?m.en:m.sv}</span><i aria-hidden="true"></i>
        </button>)}
      </div>
      <div class="pa-section-heading"><div><p class="pa-section-kicker">{en ? 'SPIKEN · THE COLLECTION' : 'SPIKEN · SAMLINGEN'}</p><h2>{en ? 'Find your words.' : 'Hitta dina ord.'}</h2></div><p>{en ? 'Search the collection or follow a feeling.' : 'Sök bland texterna eller följ en känsla.'}</p></div>
      <div class="pa-controls">
        <div class="pa-search">
          <label for="pa-search-input">{labels.search}</label>
          <div class="pa-input-wrap"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input type="search" id="pa-search-input" placeholder={labels.placeholder} autocomplete="off"/></div>
        </div>
        <div class="pa-filters" role="group" aria-label={labels.filters}>
          <button class="pa-filter" type="button" data-theme="" aria-pressed="true">{labels.all}</button>
          {moods.slice(4).map(([name,theme])=><button class="pa-filter" type="button" data-theme={theme.toLocaleLowerCase(lang)} aria-pressed="false">{name}</button>)}
        </div>
      </div>
      {poems.length > 0 ?
      <div class="pa-results">
        <div class="pa-result-line"><span>{en ? 'THE COLLECTION' : 'SAMLINGEN'}</span><output id="pa-result-count">{poems.length} {labels.count}</output></div>
        <div class="pa-grid" id="pa-poem-list">
          {poems.map((poem,i)=><article class="pa-item" data-search={(poem.title+' '+poem.theme+' '+poem.text+' '+poem.tags.join(' ')).toLocaleLowerCase(lang)} data-theme={poem.theme.toLocaleLowerCase(lang)}>
            <a href={archiveRoot + encodeURIComponent(poem.slug) + '/'} class="pa-item-link">
              <div class="pa-card-photo" style={`--pa-card-img:url("${poem.image ? base+'/images/'+poem.image : base+'/images/dikt-arkiv-v2.webp'}")`} aria-hidden="true"></div>
              <div class="pa-item-top"><span>SPIKEN / {String(i+1).padStart(3,'0')}</span><span aria-hidden="true">↗</span></div>
              <div class="pa-item-body"><span class="pa-category">{poem.theme}</span><h2>{poem.title}</h2><p>{poemExcerpt(poem.text,145)}</p></div>
              <span class="pa-read">{labels.read} <span aria-hidden="true">→</span></span>
            </a>
          </article>)}
        </div>
        <div class="pa-no-results" id="pa-no-results" hidden><p>{labels.noMatch}</p><button id="pa-clear" type="button">{labels.clear} →</button></div>
      </div>
      : <div class="pa-unpublished"><span class="pa-unpublished-icon" aria-hidden="true">✧</span><h2>{labels.emptyTitle}</h2><p>{labels.emptyText}</p>{en && <a href={base+'/dikter/'}>{labels.toSwedish} →</a>}</div>}
    </div>
  </section>
</div>
<script>
const search = document.querySelector('#pa-search-input');
const buttons = [...document.querySelectorAll('.pa-filter, .pa-mood-button')];
const cards = [...document.querySelectorAll('.pa-item')];
const noResults = document.querySelector('#pa-no-results');
const count = document.querySelector('#pa-result-count');
const clear = document.querySelector('#pa-clear');
const locale = document.documentElement.lang || 'sv';
const params = new URLSearchParams(window.location.search);
let selected = (params.get('tema') || '').toLocaleLowerCase(locale);
function refresh(){
  const q = (search?.value||'').trim().toLocaleLowerCase(locale);
  let visible=0;
  for(const card of cards){
    const matchingTheme = !selected || card.dataset.theme===selected;
    const matchingText = !q || (card.dataset.search||'').includes(q);
    card.hidden=!(matchingTheme && matchingText);
    if(!card.hidden)visible++;
  }
  buttons.forEach(b=>b.setAttribute('aria-pressed',String((b.dataset.theme||'')===selected)));
  if(count)count.textContent=String(visible)+' '+(locale==='en'?'poems':'dikter');
  if(noResults)noResults.hidden=visible>0 || cards.length===0;
}
buttons.forEach(b=>b.addEventListener('click',()=>{
  selected=b.dataset.theme||'';
  const url=new URL(window.location.href);
  if(selected)url.searchParams.set('tema',selected);
  else url.searchParams.delete('tema');
  window.history.replaceState({},'',url);
  refresh();
}));
search?.addEventListener('input',refresh);
clear?.addEventListener('click',()=>{
  selected='';
  if(search)search.value='';
  const url=new URL(window.location.href);url.searchParams.delete('tema');window.history.replaceState({},'',url);
  refresh();search?.focus();
});
refresh();
</script>
<style>
/* En enda sammanhängande arkivdesign, utifrån startsidan Spiken 3.0. */
.pa-shell{isolation:isolate;position:relative;overflow:hidden;background:#0d0b0b;color:#eee2d8;font-family:Georgia,'Times New Roman',serif;min-height:80vh}
.pa-shell::before{
 content:"";position:absolute;z-index:-1;pointer-events:none;
 top:0;left:0;right:0;height:min(1050px,110vw);min-height:760px;
 background-image:
  linear-gradient(90deg,#090808f9 0%,#090808e8 26%,#09080885 53%,#09080828 100%),
  linear-gradient(180deg,transparent 0%,#0d0b0b0d 38%,#0d0b0b91 73%,#0d0b0b 100%),
  var(--pa-image),var(--pa-fallback);
 background-size:cover;
 background-repeat:no-repeat;
 background-position:center,center,right 27%,right 27%;
}
.pa-wrap{width:min(1320px,calc(100% - 84px));margin-inline:auto}
.pa-intro{position:relative;min-height:555px;display:flex;align-items:flex-end;background:transparent;isolation:auto}
.pa-intro::before,.pa-intro::after{display:none}

.pa-intro-inner{padding:140px 0 142px}
.pa-eyebrow{font:700 11px/1.6 Arial,sans-serif;letter-spacing:.24em;color:#efcfc6;margin:0}
.pa-intro h1{font:italic 400 clamp(51px,4.8vw,73px)/1.09 Georgia,serif;letter-spacing:-.035em;max-width:730px;margin:20px 0 18px}
.pa-intro h1 em{color:#bf2029}
.pa-lead{max-width:500px;font:19px/1.6 Georgia,serif;color:#ebdcd4;margin:0}
.pa-hero-link{display:inline-flex;align-items:center;gap:26px;background:#921417;border:1px solid #b12d33;color:#fff;padding:13px 22px;margin-top:26px;font:15px Arial,sans-serif;transition:background .2s}
.pa-hero-link:hover{background:#bc2229;color:#fff}
.pa-library{position:relative;z-index:2;margin-top:-80px;padding:0 0 77px;background:linear-gradient(180deg,transparent 0px,#0d0b0b30 150px,#0d0b0bef 480px,#0d0b0b 720px);scroll-margin-top:30px;isolation:auto}
.pa-library::before{content:"";position:absolute;z-index:-1;inset:0;background:radial-gradient(ellipse at 72% 12%,#7a302a1d,transparent 42%);pointer-events:none}
.pa-mood-gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 32px;filter:drop-shadow(0 12px 22px #0009)}
.pa-mood-button{position:relative;isolation:isolate;aspect-ratio:2.12;overflow:hidden;border:1px solid #67504a;background:#241817;padding:0;color:#f7e9e0;cursor:pointer;text-align:left;box-shadow:0 2px 14px #0005}
.pa-mood-button img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .3s}
.pa-mood-button::before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(0deg,#070505d9,transparent 83%)}
.pa-mood-button span{position:absolute;bottom:26px;left:22px;font:italic clamp(26px,2.6vw,37px)/1 Georgia,serif}
.pa-mood-button i{position:absolute;bottom:12px;left:22px;width:65px;height:2px;background:#bf2029}
.pa-mood-button:hover img{transform:scale(1.055)}
.pa-mood-button[aria-pressed="true"]{border-color:#e17d80;outline:2px solid #b52b33;outline-offset:-5px}
.pa-section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;padding:0 0 18px;margin-bottom:22px;border-bottom:1px solid #54403a}
.pa-section-kicker{font:700 10px/1.4 Arial,sans-serif;color:#c5918a;letter-spacing:.24em;margin:0 0 11px}
.pa-section-heading h2{font:italic 400 clamp(33px,3.2vw,47px)/1.1 Georgia,serif;margin:0}
.pa-section-heading>p{font:16px/1.5 Georgia,serif;color:#cdb9b0;margin:0 0 4px}
.pa-controls{display:flex;align-items:end;justify-content:space-between;flex-wrap:wrap;gap:16px 25px;padding:0 0 26px;border-bottom:1px solid #544039}
.pa-search{flex:1;min-width:min(100%,290px)}
.pa-search label{display:block;font:13px/1.5 Arial,sans-serif;color:#dcc9c0;margin-bottom:9px}
.pa-input-wrap{position:relative;max-width:525px}
.pa-input-wrap svg{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:#c5a59d;pointer-events:none}
.pa-input-wrap input{display:block;width:100%;height:48px;padding:12px 15px 12px 45px;background:#1b1313;border:1px solid #6b4b43;color:#f9eee7;border-radius:0;outline-offset:3px;font:15px Arial,sans-serif}
.pa-input-wrap input::placeholder{color:#b8a39b}
.pa-filters{display:flex;gap:9px;flex-wrap:wrap}
.pa-filter{font:13px Arial,sans-serif;color:#e3cec7;background:transparent;border:1px solid #654942;padding:13px 17px;cursor:pointer;min-height:46px}
.pa-filter:hover{border-color:#c68a85}
.pa-filter[aria-pressed="true"]{color:#fff;background:#921417;border-color:#b92b31}
.pa-results{padding-top:25px}
.pa-result-line{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:0 0 18px;color:#bba29b;font:11px/1.5 Arial,sans-serif;letter-spacing:.17em}
.pa-result-line output{letter-spacing:normal}
.pa-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.pa-item{overflow:hidden;border:1px solid #62473f;background:#151011;transition:border-color .2s,transform .2s}
.pa-item[hidden]{display:none!important}
.pa-item:hover{border-color:#bb6761;transform:translateY(-2px)}
.pa-item-link{display:flex;flex-direction:column;height:100%;padding:0;color:#f4e6de}
.pa-card-photo{height:215px;background-image:linear-gradient(0deg,#1b11139e,transparent 65%),var(--pa-card-img);background-size:cover;background-position:center}
.pa-item-top{display:flex;justify-content:space-between;align-items:center;color:#caa29b;font:11px Arial,sans-serif;letter-spacing:.12em;margin:19px 24px 0}
.pa-item-top span:last-child{font-size:20px}
.pa-item-body{flex:1;padding:17px 24px 19px}
.pa-category{color:#cb9694;font:11px/1.4 Arial,sans-serif;text-transform:uppercase;letter-spacing:.18em}
.pa-item h2{font:italic 400 clamp(28px,2.7vw,39px)/1.16 Georgia,serif;margin:11px 0 14px;overflow-wrap:anywhere}
.pa-item p{font:16px/1.6 Georgia,serif;color:#d9c0ba;white-space:pre-line;margin:0}
.pa-read{margin:0 24px 22px;padding-top:16px;display:flex;justify-content:space-between;gap:10px;border-top:1px solid #735049;font:13px Arial,sans-serif;color:#f2dbd5}
.pa-unpublished{max-width:680px;margin:32px auto 12px;padding:43px 20px 58px;text-align:center;background:radial-gradient(ellipse at center,#3b202333,transparent 72%)}
.pa-unpublished-icon{font-size:35px;color:#c02f38}
.pa-unpublished h2{font:italic 400 clamp(30px,3.6vw,47px)/1.2 Georgia,serif;margin:17px 0}
.pa-unpublished p{font:17px/1.75 Georgia,serif;color:#ddc7c0}
.pa-unpublished a,.pa-no-results button{display:inline-block;margin-top:14px;color:#eeddD8;background:none;border:0;border-bottom:1px solid #b52b34;padding:9px 0;cursor:pointer;font:14px Arial,sans-serif}
.pa-no-results{text-align:center;padding:50px 0}
.pa-no-results[hidden]{display:none}
@media(max-width:950px){
 .pa-wrap{width:calc(100% - 40px)}
 .pa-mood-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}
 .pa-mood-button{aspect-ratio:2}
 .pa-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .pa-section-heading{align-items:start;flex-direction:column}
}
@media(max-width:600px){
 .pa-wrap{width:calc(100% - 36px)}
 .pa-intro{min-height:595px}
 .pa-shell::before{height:1000px;min-height:0;background-image:linear-gradient(0deg,#0d0b0b 0%,#0d0b0b9e 47%,#0d0b0b28 84%),linear-gradient(90deg,#09080890,transparent 78%),var(--pa-image),var(--pa-fallback);background-position:center,center,60% top,60% top}
 .pa-intro-inner{padding:235px 0 142px}
 .pa-intro h1{font-size:clamp(45px,10.5vw,67px)}
 .pa-lead{font-size:17px}
 .pa-hero-link{font-size:14px}
 .pa-library{margin-top:-99px;padding-bottom:58px}
 .pa-library{background:linear-gradient(180deg,transparent 0px,#0d0b0b6b 140px,#0d0b0bee 450px,#0d0b0b 710px)}
 .pa-mood-gallery{gap:10px;margin-bottom:27px}
 .pa-mood-button{aspect-ratio:1.55}
 .pa-mood-button span{left:13px;bottom:22px;font-size:clamp(23px,6vw,30px)}
 .pa-mood-button i{left:13px;width:48px}
 .pa-section-heading h2{font-size:36px}
 .pa-section-heading>p{font-size:15px}
 .pa-controls{align-items:stretch}
 .pa-search{flex:1 1 100%}
 .pa-input-wrap{max-width:none}
 .pa-grid{grid-template-columns:1fr}
 .pa-card-photo{height:205px}
 .pa-item h2{font-size:33px}
 .pa-unpublished{padding:30px 7px 40px}
}
@media(prefers-reduced-motion:reduce){.pa-item,.pa-mood-button img,.pa-hero-link{transition:none}}
</style>
