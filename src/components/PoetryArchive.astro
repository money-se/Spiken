---
import { getPoems, poemExcerpt } from '../lib/poetry.js';
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const archiveRoot = base + (en ? '/en/poems/' : '/dikter/');
const poems = getPoems(lang);
const searchIndexUrl = base + (en ? '/en/poems/search-index.json' : '/dikter/sokindex.json');
const labels = en ? {
  kicker:'SPIKEN · WORDS BENEATH THE SKIN',title:'Poetry',titleAccent:'archive.',
  intro:'For everything that stayed beneath the surface. Find a feeling, a title or the words that speak to you.',
  search:'Search the poems',placeholder:'Search titles, feelings or words…',all:'All poems',
  emptyTitle:'A place for words not yet published.',emptyText:'English translations will appear here when they have been carefully prepared and published. In the meantime, you can explore the Swedish original archive.',
  toSwedish:'Explore Swedish poems',count:'poems',read:'Read poem',noMatch:'No poems match your search.',clear:'Show all poems',
  filters:'Browse by feeling',more:'Show more poems',showing:'Showing',of:'of',sort:'Sort by',newest:'Newest first',oldest:'Oldest first',az:'Title A–Z',discover:'Surprise me with a poem',surpriseKicker:'A poem chosen for you',surpriseMore:'Surprise me again',surpriseRead:'Read the whole poem',surpriseClose:'Close',searchLoading:'Searching…',searchError:'Full-text search is unavailable right now. Titles and themes still work.'
} : {
  kicker:'SPIKEN · ORD UNDER HUDEN',title:'Dikt',titleAccent:'arkivet.',
  intro:'För allt som aldrig riktigt fick plats i ett samtal. Sök en känsla, en titel eller de ord du behöver läsa just nu.',
  search:'Sök bland dikterna',placeholder:'Sök titel, känsla eller ord…',all:'Alla dikter',
  emptyTitle:'Här får orden snart sin plats.',emptyText:'Arkivet är förberett för dina dikter. Så snart de publiceras kommer de att visas här, med egna lässidor och möjlighet att dela.',
  toSwedish:'',count:'dikter',read:'Läs dikten',noMatch:'Inga dikter matchar din sökning.',clear:'Visa alla dikter',
  filters:'Välj en känsla',more:'Visa fler dikter',showing:'Visar',of:'av',sort:'Sortera',newest:'Nyaste först',oldest:'Äldsta först',az:'Titel A–Ö',discover:'Överraska mig med en dikt',surpriseKicker:'Ett oväntat möte med orden',surpriseMore:'Överraska mig igen',surpriseRead:'Läs hela dikten',surpriseClose:'Stäng',searchLoading:'Söker…',searchError:'Sökning i hela dikter är tillfälligt otillgänglig. Titlar och kategorier fungerar fortfarande.'
};
const availableThemes = [...new Set(poems.map(poem => poem.theme))].sort((a,b) => a.localeCompare(b,lang));
const image = base + '/images/spiken-arkiv-hero.webp';
const fallbackImage = base + '/images/spiken-3-forfattare.webp';
---
<div class="pa-shell" style={`--pa-image:url("${image}");--pa-fallback:url("${fallbackImage}")`}>
  <section class="pa-intro" aria-labelledby="pa-title">
    <div class="pa-wrap pa-intro-inner">
      <p class="pa-eyebrow">{labels.kicker}</p>
      <h1 id="pa-title">{labels.title}<em>{labels.titleAccent}</em></h1>
      <p class="pa-lead">{labels.intro}</p>
      <a class="pa-hero-link" href="#pa-explore">{en ? "Explore the archive" : "Utforska dikterna"} <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="pa-library" id="pa-explore" aria-label={en ? 'Browse poetry' : 'Utforska dikter'}>
    <div class="pa-wrap">
      
      <div class="pa-mood-gallery" role="group" aria-label={labels.filters}>
        {[
          {sv:'Kärlek',en:'Love',image:'kategori-karlek'},
          {sv:'Längtan',en:'Longing',image:'kategori-sorg'},
          {sv:'Begär',en:'Desire',image:'kategori-begar-v2'},
          {sv:'Existens',en:'Existence',image:'kategori-ensamhet'}
        ].map(m => <button type="button" class="pa-mood-button" data-theme={(en?m.en:m.sv).toLocaleLowerCase(lang)} aria-pressed="false">
          <img src={base+'/images/'+m.image+'.webp'} loading="lazy" alt="" width="520" height="300" />
          <span>{en?m.en:m.sv}</span><i aria-hidden="true"></i>
        </button>)}
      </div>
      <div class="pa-section-heading"><div><p class="pa-section-kicker">{en ? 'SPIKEN · THE COLLECTION' : 'SPIKEN · SAMLINGEN'}</p><h2>{en ? 'Find your words.' : 'Hitta dina ord.'}</h2></div><p>{en ? 'Search the collection or follow a feeling.' : 'Sök bland texterna eller följ en känsla.'}</p></div>
      <div class="pa-controls">
        <div class="pa-search">
          <label for="pa-search-input">{labels.search}</label>
          <div class="pa-input-wrap"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input type="search" id="pa-search-input" placeholder={labels.placeholder} autocomplete="off"/></div>
        </div>
        <div class="pa-filters" role="group" aria-label={labels.filters}>
          <button class="pa-filter" type="button" data-theme="" aria-pressed="true">{labels.all}</button>
          {availableThemes.map(theme=><button class="pa-filter" type="button" data-theme={theme.toLocaleLowerCase(lang)} aria-pressed="false">{theme} <span class="pa-filter-count">{poems.filter(poem=>poem.theme===theme).length}</span></button>)}
        </div>
        <div class="pa-sort">
          <label for="pa-sort-select">{labels.sort}</label>
          <select id="pa-sort-select">
            <option value="newest">{labels.newest}</option>
            <option value="oldest">{labels.oldest}</option>
            <option value="title">{labels.az}</option>
          </select>
        </div>
      </div>
      {poems.length > 0 ?
      <div class="pa-results" data-search-index-url={searchIndexUrl} data-index-error={labels.searchError} data-index-loading={labels.searchLoading}>
        <div class="pa-result-line"><span>{en ? 'THE COLLECTION' : 'SAMLINGEN'}</span><div class="pa-result-actions"><output id="pa-result-count">{poems.length} {labels.count}</output><button type="button" id="pa-discover" hidden>{labels.discover} <span aria-hidden="true">↗</span></button></div></div>
        <p class="pa-search-warning" id="pa-search-warning" role="status" hidden></p>
        <div class="pa-grid" id="pa-poem-list">
          {poems.map((poem,i)=><article class="pa-item" data-search={(poem.title+' '+poem.theme+' '+poem.tags.join(' ')).toLocaleLowerCase(lang)} data-slug={poem.slug} data-image={poem.image ? base+'/images/'+poem.image : base+'/images/dikt-arkiv-v2.webp'} data-theme={poem.theme.toLocaleLowerCase(lang)} data-date={poem.published || ''} data-title={poem.title.toLocaleLowerCase(lang)} data-order={i}>
            <a href={archiveRoot + encodeURIComponent(poem.slug) + '/'} class="pa-item-link">
              <div class="pa-card-photo" style={`--pa-card-img:url("${poem.image ? base+'/images/'+poem.image : base+'/images/dikt-arkiv-v2.webp'}")`} aria-hidden="true"></div>
              <div class="pa-item-top"><span>SPIKEN / {String(i+1).padStart(3,'0')}</span><span aria-hidden="true">↗</span></div>
              <div class="pa-item-body"><span class="pa-category">{poem.theme}</span><h2>{poem.title}</h2><p>{poemExcerpt(poem.text,145)}</p></div>
              <span class="pa-read">{labels.read} <span aria-hidden="true">→</span></span>
            </a>
          </article>)}
        </div>
        <div class="pa-pagination" id="pa-pagination" hidden>
          <p id="pa-pagination-status" role="status" aria-live="polite"></p>
          <button type="button" id="pa-show-more" aria-controls="pa-poem-list">{labels.more} <span aria-hidden="true">↓</span></button>
        </div>
        <div class="pa-no-results" id="pa-no-results" hidden><p>{labels.noMatch}</p><button id="pa-clear" type="button">{labels.clear} →</button></div>
      </div>
      : <div class="pa-unpublished"><span class="pa-unpublished-icon" aria-hidden="true">✧</span><h2>{labels.emptyTitle}</h2><p>{labels.emptyText}</p>{en && <a href={base+'/dikter/'}>{labels.toSwedish} →</a>}</div>}
    </div>
  </section>
  <dialog class="pa-discovery" id="pa-discovery" aria-labelledby="pa-discovery-title" aria-describedby="pa-discovery-excerpt">
    <div class="pa-discovery-inner">
      <button type="button" class="pa-discovery-close" id="pa-discovery-close" aria-label={labels.surpriseClose}>×</button>
      <div class="pa-discovery-picture"><img id="pa-discovery-image" alt="" width="680" height="400" /></div>
      <div class="pa-discovery-content">
        <p class="pa-discovery-kicker">{labels.surpriseKicker}</p>
        <span class="pa-discovery-theme" id="pa-discovery-theme"></span>
        <h2 id="pa-discovery-title"></h2>
        <p class="pa-discovery-excerpt" id="pa-discovery-excerpt"></p>
        <div class="pa-discovery-actions">
          <a id="pa-discovery-read" class="pa-discovery-read" href="#">{labels.surpriseRead} <span aria-hidden="true">→</span></a>
          <button type="button" id="pa-discovery-another" class="pa-discovery-another">{labels.surpriseMore} <span aria-hidden="true">↻</span></button>
        </div>
      </div>
    </div>
  </dialog>
</div>
<script>
const search = document.querySelector('#pa-search-input');
const buttons = [...document.querySelectorAll('.pa-filter, .pa-mood-button')];
const cards = [...document.querySelectorAll('.pa-item')];
const grid = document.querySelector('#pa-poem-list');
const sortControl = document.querySelector('#pa-sort-select');
const results = document.querySelector('.pa-results');
const searchWarning = document.querySelector('#pa-search-warning');
const surprise = document.querySelector('#pa-discover');
const discoveryDialog = document.querySelector('#pa-discovery');
const discoveryImage = document.querySelector('#pa-discovery-image');
const discoveryTitle = document.querySelector('#pa-discovery-title');
const discoveryTheme = document.querySelector('#pa-discovery-theme');
const discoveryExcerpt = document.querySelector('#pa-discovery-excerpt');
const discoveryRead = document.querySelector('#pa-discovery-read');
const discoveryAnother = document.querySelector('#pa-discovery-another');
const discoveryClose = document.querySelector('#pa-discovery-close');
const noResults = document.querySelector('#pa-no-results');
const count = document.querySelector('#pa-result-count');
const clear = document.querySelector('#pa-clear');
const pagination = document.querySelector('#pa-pagination');
const more = document.querySelector('#pa-show-more');
const pageStatus = document.querySelector('#pa-pagination-status');
const locale = document.documentElement.lang || 'sv';
const params = new URLSearchParams(window.location.search);
const PAGE_SIZE = 9;
const normalize = value => (value || '').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase(locale);
// Bara korta sökfält finns i HTML. Dikternas hela texter hämtas vid första sökningen.
const searchable = new Map(cards.map(card => [card, normalize(card.dataset.search)]));
let fulltext = null;
let indexRequest = null;
let requestVersion = 0;
let matchingCards = [];
let remainingSurprises = [];
let previousSurprise = null;
let surprisePoolKey = '';
let limit = PAGE_SIZE;
let selected = (params.get('tema') || '').toLocaleLowerCase(locale);
const validThemes = new Set(buttons.map(button => button.dataset.theme || ''));
if(!validThemes.has(selected)) selected = '';
const orderOptions = new Set(['newest','oldest','title']);
let sorting = orderOptions.has(params.get('sort')) ? params.get('sort') : 'newest';
let renderedSort = null;
let searchDelay = null;
if(sortControl) sortControl.value = sorting;
if(search && params.get('q')) search.value = params.get('q');

async function ensureFulltext(){
  if(fulltext) return;
  if(!indexRequest){
    indexRequest = fetch(results.dataset.searchIndexUrl)
      .then(response => {
        if(!response.ok) throw new Error('Search index HTTP '+response.status);
        return response.json();
      })
      .then(rows => {
        if(!Array.isArray(rows)) throw new Error('Invalid search index');
        fulltext = new Map(rows.map(item => [item.slug,normalize(item.text)]));
      }).catch(error => { indexRequest = null; throw error; });
  }
  await indexRequest;
}
function syncUrl(){
  const url = new URL(window.location.href);
  if(selected) url.searchParams.set('tema', selected);
  else url.searchParams.delete('tema');
  const q = search?.value.trim() || '';
  if(q) url.searchParams.set('q',q);
  else url.searchParams.delete('q');
  if(sorting!=='newest') url.searchParams.set('sort',sorting);
  else url.searchParams.delete('sort');
  window.history.replaceState({},'',url);
}
function reorder(){
  if(!grid || sorting===renderedSort) return;
  const ordered = [...cards].sort((a,b)=>{
    if(sorting==='title') return (a.dataset.title||'').localeCompare(b.dataset.title||'',locale);
    const delta = (a.dataset.date||'').localeCompare(b.dataset.date||'');
    return (sorting==='oldest' ? delta : -delta) || (Number(a.dataset.order)-Number(b.dataset.order));
  });
  for(const card of ordered) grid.appendChild(card);
  renderedSort=sorting;
}
function refresh(){
  const terms = normalize(search?.value.trim()).split(/\s+/).filter(Boolean);
  let shown = 0;
  matchingCards = [];
  const ordered = grid ? [...grid.querySelectorAll('.pa-item')] : cards;
  for(const card of ordered){
    const matchingTheme = !selected || card.dataset.theme===selected;
    const haystack = searchable.get(card) + ' ' + (fulltext?.get(card.dataset.slug) || '');
    const matchingText = terms.every(term=>haystack.includes(term));
    if(matchingTheme && matchingText){
      matchingCards.push(card);
      card.hidden = shown >= limit;
      if(!card.hidden) shown++;
    } else {
      card.hidden = true;
    }
  }
  const matched = matchingCards.length;
  // Bevara en påbörjad upptäcktsrunda när bara sorteringen ändras.
  const poolKey = matchingCards.map(card => card.dataset.slug).sort().join('|');
  if(poolKey !== surprisePoolKey){
    surprisePoolKey = poolKey;
    remainingSurprises = [];
  }
  buttons.forEach(b=>b.setAttribute('aria-pressed',String((b.dataset.theme||'')===selected)));
  if(count) count.textContent=String(matched)+' '+(locale==='en'?'poems':'dikter');
  if(noResults) noResults.hidden=matched>0 || cards.length===0;
  if(pagination) pagination.hidden=matched<=PAGE_SIZE;
  if(pageStatus) pageStatus.textContent=(locale==='en'?'Showing ':'Visar ')+shown+(locale==='en'?' of ':' av ')+matched+(locale==='en'?' poems':' dikter');
  if(more) more.hidden=shown>=matched;
  if(surprise){
    surprise.hidden=matched===0;
    surprise.disabled=matched===0;
  }
}
async function applyFilters(){
  const version=++requestVersion;
  limit=PAGE_SIZE;
  reorder();
  syncUrl();
  const q=search?.value.trim()||'';
  if(q && !fulltext){
    if(count) count.textContent=results.dataset.indexLoading||'…';
    try {
      await ensureFulltext();
      if(searchWarning) searchWarning.hidden=true;
    } catch {
      if(searchWarning){
        searchWarning.textContent=results.dataset.indexError||'';
        searchWarning.hidden=false;
      }
    }
  } else if(searchWarning) searchWarning.hidden=true;
  if(version!==requestVersion) return;
  refresh();
}
buttons.forEach(button=>button.addEventListener('click',()=>{
  selected=button.dataset.theme||'';
  void applyFilters();
}));
search?.addEventListener('input',()=>{
  // Undvik onödiga DOM-uppdateringar för varje tangenttryckning.
  window.clearTimeout(searchDelay);
  searchDelay=window.setTimeout(()=>{void applyFilters();},180);
});
sortControl?.addEventListener('change',()=>{
  sorting=orderOptions.has(sortControl.value)?sortControl.value:'newest';
  void applyFilters();
});
clear?.addEventListener('click',()=>{
  selected='';
  if(search) search.value='';
  void applyFilters();
  search?.focus();
});
more?.addEventListener('click',()=>{
  limit+=PAGE_SIZE;
  refresh();
});
function chooseSurprise(){
  if(!matchingCards.length) return;
  if(!remainingSurprises.length){
    // Slumpa alla matchande dikter utan upprepningar tills rundan är slut.
    remainingSurprises = [...matchingCards];
    for(let i=remainingSurprises.length-1; i>0; i--){
      const j=Math.floor(Math.random()*(i+1));
      [remainingSurprises[i],remainingSurprises[j]]=[remainingSurprises[j],remainingSurprises[i]];
    }
    // Undvik samma dikt två gånger direkt vid gränsen mellan två rundor.
    if(remainingSurprises.length>1 && remainingSurprises[remainingSurprises.length-1]===previousSurprise){
      [remainingSurprises[0],remainingSurprises[remainingSurprises.length-1]]=
        [remainingSurprises[remainingSurprises.length-1],remainingSurprises[0]];
    }
  }
  const chosen=remainingSurprises.pop();
  previousSurprise=chosen;
  const link=chosen.querySelector('.pa-item-link');
  if(!link) return;
  if(!discoveryDialog || typeof discoveryDialog.showModal!=='function'){
    window.location.assign(link.href);
    return;
  }
  discoveryTitle.textContent=chosen.querySelector('.pa-item-body h2')?.textContent||'';
  discoveryTheme.textContent=chosen.querySelector('.pa-category')?.textContent||'';
  discoveryExcerpt.textContent=chosen.querySelector('.pa-item-body p')?.textContent||'';
  discoveryRead.href=link.href;
  const image=chosen.dataset.image||'';
  if(image){
    discoveryImage.src=image;
    discoveryImage.hidden=false;
  } else {
    discoveryImage.removeAttribute('src');
    discoveryImage.hidden=true;
  }
  if(!discoveryDialog.open) discoveryDialog.showModal();
}
surprise?.addEventListener('click',chooseSurprise);
discoveryAnother?.addEventListener('click',chooseSurprise);
discoveryClose?.addEventListener('click',()=>discoveryDialog?.close());
discoveryDialog?.addEventListener('click',event=>{
  if(event.target===discoveryDialog) discoveryDialog.close();
});
reorder();
void applyFilters();
</script>
<style>
/* En enda sammanhängande arkivdesign, utifrån startsidan Spiken 3.0. */
.pa-shell{isolation:isolate;position:relative;overflow:hidden;background:#0d0b0b;color:#eee2d8;font-family:Georgia,'Times New Roman',serif;min-height:80vh}
.pa-shell::before{
 content:"";position:absolute;z-index:-1;pointer-events:none;
 top:0;left:0;right:0;height:min(1050px,110vw);min-height:760px;
 background-image:
  linear-gradient(90deg,#090808f9 0%,#090808e8 26%,#09080885 53%,#09080828 100%),
  linear-gradient(180deg,transparent 0%,#0d0b0b0d 38%,#0d0b0b91 73%,#0d0b0b 100%),
  var(--pa-image),var(--pa-fallback);
 background-size:cover;
 background-repeat:no-repeat;
 background-position:center,center,right 27%,right 27%;
}
.pa-wrap{width:min(1320px,calc(100% - 84px));margin-inline:auto}
.pa-intro{position:relative;min-height:555px;display:flex;align-items:flex-end;background:transparent;isolation:auto}
.pa-intro::before,.pa-intro::after{display:none}

.pa-intro-inner{padding:140px 0 142px}
.pa-eyebrow{font:700 11px/1.6 Arial,sans-serif;letter-spacing:.24em;color:#efcfc6;margin:0}
.pa-intro h1{font:italic 400 clamp(51px,4.8vw,73px)/1.09 Georgia,serif;letter-spacing:-.035em;max-width:730px;margin:20px 0 18px}
.pa-intro h1 em{color:#bf2029}
.pa-lead{max-width:500px;font:19px/1.6 Georgia,serif;color:#ebdcd4;margin:0}
.pa-hero-link{display:inline-flex;align-items:center;gap:26px;background:#921417;border:1px solid #b12d33;color:#fff;padding:13px 22px;margin-top:26px;font:15px Arial,sans-serif;transition:background .2s}
.pa-hero-link:hover{background:#bc2229;color:#fff}
.pa-library{position:relative;z-index:2;margin-top:-80px;padding:0 0 77px;background:linear-gradient(180deg,transparent 0px,#0d0b0b30 150px,#0d0b0bef 480px,#0d0b0b 720px);scroll-margin-top:30px;isolation:auto}
.pa-library::before{content:"";position:absolute;z-index:-1;inset:0;background:radial-gradient(ellipse at 72% 12%,#7a302a1d,transparent 42%);pointer-events:none}
.pa-mood-gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 32px;filter:drop-shadow(0 12px 22px #0009)}
.pa-mood-button{position:relative;isolation:isolate;aspect-ratio:2.12;overflow:hidden;border:1px solid #67504a;background:#241817;padding:0;color:#f7e9e0;cursor:pointer;text-align:left;box-shadow:0 2px 14px #0005}
.pa-mood-button img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .3s}
.pa-mood-button::before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(0deg,#070505d9,transparent 83%)}
.pa-mood-button span{position:absolute;bottom:26px;left:22px;font:italic clamp(26px,2.6vw,37px)/1 Georgia,serif}
.pa-mood-button i{position:absolute;bottom:12px;left:22px;width:65px;height:2px;background:#bf2029}
.pa-mood-button:hover img{transform:scale(1.055)}
.pa-mood-button[aria-pressed="true"]{border-color:#e17d80;outline:2px solid #b52b33;outline-offset:-5px}
.pa-section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;padding:0 0 18px;margin-bottom:22px;border-bottom:1px solid #54403a}
.pa-section-kicker{font:700 10px/1.4 Arial,sans-serif;color:#c5918a;letter-spacing:.24em;margin:0 0 11px}
.pa-section-heading h2{font:italic 400 clamp(33px,3.2vw,47px)/1.1 Georgia,serif;margin:0}
.pa-section-heading>p{font:16px/1.5 Georgia,serif;color:#cdb9b0;margin:0 0 4px}
.pa-controls{display:flex;align-items:end;justify-content:space-between;flex-wrap:wrap;gap:16px 25px;padding:0 0 26px;border-bottom:1px solid #544039}
.pa-search{flex:1;min-width:min(100%,290px)}
.pa-search label{display:block;font:13px/1.5 Arial,sans-serif;color:#dcc9c0;margin-bottom:9px}
.pa-input-wrap{position:relative;max-width:525px}
.pa-input-wrap svg{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:#c5a59d;pointer-events:none}
.pa-input-wrap input{display:block;width:100%;height:48px;padding:12px 15px 12px 45px;background:#1b1313;border:1px solid #6b4b43;color:#f9eee7;border-radius:0;outline-offset:3px;font:15px Arial,sans-serif}
.pa-input-wrap input::placeholder{color:#b8a39b}
.pa-filters{display:flex;gap:9px;flex-wrap:wrap;flex:1 1 420px}
.pa-filter{font:13px Arial,sans-serif;color:#e3cec7;background:transparent;border:1px solid #654942;padding:13px 17px;cursor:pointer;min-height:46px}
.pa-filter:hover{border-color:#c68a85}
.pa-filter-count{opacity:.7;font-size:11px;margin-left:5px}
.pa-sort{display:flex;align-items:center;gap:10px;margin-left:auto;padding-bottom:1px}
.pa-sort label{font:13px Arial,sans-serif;color:#dcc9c0;white-space:nowrap}
.pa-sort select{height:46px;padding:10px 28px 10px 11px;color:#f9eee7;background:#1b1313;border:1px solid #6b4b43;font:13px Arial,sans-serif}
.pa-sort select:focus-visible{outline:2px solid #e6babb;outline-offset:3px}
.pa-filter[aria-pressed="true"]{color:#fff;background:#921417;border-color:#b92b31}
.pa-results{padding-top:25px}
