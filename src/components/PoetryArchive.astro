---
import { getPoems, poemExcerpt } from '../lib/poetry.js';
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const archiveRoot = base + (en ? '/en/poems/' : '/dikter/');
const poems = getPoems(lang);
const labels = en ? {
  kicker:'SPIKEN · WORDS BENEATH THE SKIN',title:'Poetry',titleAccent:'archive.',
  intro:'For everything that stayed beneath the surface. Find a feeling, a title or the words that speak to you.',
  search:'Search the poems',placeholder:'Search titles, feelings or words…',all:'All',
  emptyTitle:'A place for words not yet published.',emptyText:'English translations will appear here when they have been carefully prepared and published. In the meantime, you can explore the Swedish original archive.',
  toSwedish:'Explore Swedish poems',count:'poems',read:'Read poem',noMatch:'No poems match your search.',clear:'Show all poems',
  filters:'Browse by feeling'
} : {
  kicker:'SPIKEN · ORD UNDER HUDEN',title:'Dikt',titleAccent:'arkivet.',
  intro:'För allt som aldrig riktigt fick plats i ett samtal. Sök en känsla, en titel eller de ord du behöver läsa just nu.',
  search:'Sök bland dikterna',placeholder:'Sök titel, känsla eller ord…',all:'Alla',
  emptyTitle:'Här får orden snart sin plats.',emptyText:'Arkivet är förberett för dina dikter. Så snart de publiceras kommer de att visas här, med egna lässidor och möjlighet att dela.',
  toSwedish:'',count:'dikter',read:'Läs dikten',noMatch:'Inga dikter matchar din sökning.',clear:'Visa alla dikter',
  filters:'Välj en känsla'
};
const moods = en ? [
  ['Love','Love'],['Longing','Longing'],['Desire','Desire'],['Existence','Existence'],['Heartbreak','Heartbreak'],['Missing','Missing']
] : [
  ['Kärlek','Kärlek'],['Längtan','Längtan'],['Begär','Begär'],['Existens','Existens'],['Hjärtesorg','Hjärtesorg'],['Saknad','Saknad']
];
const image = base + '/images/spiken-arkiv-hero.webp';
const fallbackImage = base + '/images/spiken-3-forfattare.webp';
---
<div class="pa-shell" style={`--pa-image:url("${image}");--pa-fallback:url("${fallbackImage}")`}>
  <section class="pa-intro" aria-labelledby="pa-title">
    <div class="pa-wrap pa-intro-inner">
      <p class="pa-eyebrow">{labels.kicker}</p>
      <h1 id="pa-title">{labels.title}<em>{labels.titleAccent}</em></h1>
      <p class="pa-lead">{labels.intro}</p>
      <a class="pa-hero-link" href="#pa-explore">{en ? "Explore the archive" : "Utforska dikterna"} <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="pa-library" id="pa-explore" aria-label={en ? 'Browse poetry' : 'Utforska dikter'}>
    <div class="pa-wrap">
      
      <div class="pa-mood-gallery" role="group" aria-label={labels.filters}>
        {[
          {sv:'Kärlek',en:'Love',image:'kategori-karlek'},
          {sv:'Längtan',en:'Longing',image:'kategori-sorg'},
          {sv:'Begär',en:'Desire',image:'kategori-begar-v2'},
          {sv:'Existens',en:'Existence',image:'kategori-ensamhet'}
        ].map(m => <button type="button" class="pa-mood-button" data-theme={(en?m.en:m.sv).toLocaleLowerCase(lang)} aria-pressed="false">
          <img src={base+'/images/'+m.image+'.webp'} loading="lazy" alt="" width="520" height="300" />
          <span>{en?m.en:m.sv}</span><i aria-hidden="true"></i>
        </button>)}
      </div>
      <div class="pa-section-heading"><h2>{en ? 'Choose a feeling.' : 'Välj en känsla.'}</h2><p>{en ? 'Every feeling has its own words.' : 'Varje känsla har sina egna ord.'}</p></div>
      <div class="pa-controls">
        <div class="pa-search">
          <label for="pa-search-input">{labels.search}</label>
          <div class="pa-input-wrap"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input type="search" id="pa-search-input" placeholder={labels.placeholder} autocomplete="off"/></div>
        </div>
        <div class="pa-filters" role="group" aria-label={labels.filters}>
          <button class="pa-filter" type="button" data-theme="" aria-pressed="true">{labels.all}</button>
          {moods.map(([name,theme])=><button class="pa-filter" type="button" data-theme={theme.toLocaleLowerCase(lang)} aria-pressed="false">{name}</button>)}
        </div>
      </div>
      {poems.length > 0 ?
      <div class="pa-results">
        <div class="pa-result-line"><span>{en ? 'THE COLLECTION' : 'SAMLINGEN'}</span><output id="pa-result-count">{poems.length} {labels.count}</output></div>
        <div class="pa-grid" id="pa-poem-list">
          {poems.map((poem,i)=><article class="pa-item" data-search={(poem.title+' '+poem.theme+' '+poem.text+' '+poem.tags.join(' ')).toLocaleLowerCase(lang)} data-theme={poem.theme.toLocaleLowerCase(lang)}>
            <a href={archiveRoot + encodeURIComponent(poem.slug) + '/'} class="pa-item-link">
              <div class="pa-card-photo" style={`--pa-card-img:url("${poem.image ? base+'/images/'+poem.image : base+'/images/dikt-arkiv-v2.webp'}")`} aria-hidden="true"></div>
              <div class="pa-item-top"><span>SPIKEN / {String(i+1).padStart(3,'0')}</span><span aria-hidden="true">↗</span></div>
              <div class="pa-item-body"><span class="pa-category">{poem.theme}</span><h2>{poem.title}</h2><p>{poemExcerpt(poem.text,145)}</p></div>
              <span class="pa-read">{labels.read} <span aria-hidden="true">→</span></span>
            </a>
          </article>)}
        </div>
        <div class="pa-no-results" id="pa-no-results" hidden><p>{labels.noMatch}</p><button id="pa-clear" type="button">{labels.clear} →</button></div>
      </div>
      : <div class="pa-unpublished"><span class="pa-unpublished-icon" aria-hidden="true">✧</span><h2>{labels.emptyTitle}</h2><p>{labels.emptyText}</p>{en && <a href={base+'/dikter/'}>{labels.toSwedish} →</a>}</div>}
    </div>
  </section>
</div>
<script>
const search = document.querySelector('#pa-search-input');
const buttons = [...document.querySelectorAll('.pa-filter, .pa-mood-button')];
const cards = [...document.querySelectorAll('.pa-item')];
const noResults = document.querySelector('#pa-no-results');
const count = document.querySelector('#pa-result-count');
const clear = document.querySelector('#pa-clear');
const locale = document.documentElement.lang || 'sv';
const params = new URLSearchParams(window.location.search);
let selected = (params.get('tema') || '').toLocaleLowerCase(locale);
function refresh(){
  const q = (search?.value||'').trim().toLocaleLowerCase(locale);
  let visible=0;
  for(const card of cards){
    const matchingTheme = !selected || card.dataset.theme===selected;
    const matchingText = !q || (card.dataset.search||'').includes(q);
    card.hidden=!(matchingTheme && matchingText);
    if(!card.hidden)visible++;
  }
  buttons.forEach(b=>b.setAttribute('aria-pressed',String((b.dataset.theme||'')===selected)));
  if(count)count.textContent=String(visible)+' '+(locale==='en'?'poems':'dikter');
  if(noResults)noResults.hidden=visible>0 || cards.length===0;
}
buttons.forEach(b=>b.addEventListener('click',()=>{
  selected=b.dataset.theme||'';
  const url=new URL(window.location.href);
  if(selected)url.searchParams.set('tema',selected);
  else url.searchParams.delete('tema');
  window.history.replaceState({},'',url);
  refresh();
}));
search?.addEventListener('input',refresh);
clear?.addEventListener('click',()=>{
  selected='';
  if(search)search.value='';
  const url=new URL(window.location.href);url.searchParams.delete('tema');window.history.replaceState({},'',url);
  refresh();search?.focus();
});
refresh();
</script>
<style>
