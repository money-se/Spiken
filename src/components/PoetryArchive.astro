.pa-unpublished a,.pa-no-results button{display:inline-block;margin-top:13px;padding:10px 0;border:0;border-bottom:1px solid #b72a34;background:transparent;color:#f1e6df;font:14px Arial,sans-serif;cursor:pointer}
.pa-no-results{text-align:center;padding:45px 0}.pa-no-results[hidden]{display:none}
@media(max-width:850px){.pa-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.pa-wrap{width:calc(100% - 36px)}.pa-intro{min-height:310px}.pa-intro-inner{padding:56px 0}.pa-intro h1{font-size:clamp(48px,11vw,70px)}.pa-lead{font-size:17px}.pa-grid{grid-template-columns:1fr}.pa-item,.pa-item-link{min-height:265px}.pa-library{padding-bottom:65px}.pa-filter{padding:10px 12px;font-size:13px}.pa-unpublished{padding:40px 6px 60px}}
