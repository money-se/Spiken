---
const {lang='sv'}=Astro.props;
const en=lang==='en';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const archive=base+(en?'/en/poems/':'/dikter/');
const worlds=base+(en?'/en/worlds/':'/varldar/');
const t=en?{
 eyebrow:'SPIKEN · BEHIND THE WORDS',title:'Behind the',accent:'words.',
 lead:'A place for what we rarely dare to say out loud. For love, longing, darkness and all the contradictions of being human.',
 read:'Read the poems',explore:'Spiken’s Worlds',
 heading:'Words without a mask.',
 p1:'Spiken is a way to explore and understand what it means to be human. Some words are tender, others uncomfortable, but they all come from a desire to feel something real.',
 p2:'Here, poetry, reflections and imagined worlds live side by side. Not because they have the same subject, but because they come from the same questions.',
 quote:'Words beneath the skin.',bottom:'Enter the poetry archive'
}:{
 eyebrow:'SPIKEN · MANNEN BAKOM ORDEN',title:'Bakom',accent:'orden.',
 lead:'En plats för allt det vi sällan vågar säga högt. För kärlek, längtan, mörker och allt det motsägelsefulla i att vara människa.',
 read:'Läs mina dikter',explore:'Spikens världar',
 heading:'Ord utan mask.',
 p1:'Spiken är ett sätt att utforska och förstå det mänskliga. Vissa ord är ömma, andra obekväma, men alla växer ur viljan att känna något på riktigt.',
 p2:'Här får dikter, reflektioner och påhittade världar finnas sida vid sida. Inte för att de handlar om samma sak, utan för att de föds ur samma frågor.',
 quote:'Ord under huden.',bottom:'Gå till diktarkivet'
};
---
<div class="sp-about" style={`--sp-about-photo:url("${base}/images/spiken-om-sovrum.webp")`}>
 <section class="sp-about-hero">
  <div class="sp-about-inner">
   <p class="sp-about-eyebrow">{t.eyebrow}</p>
   <h1>{t.title} <em>{t.accent}</em></h1>
   <p class="sp-about-lead">{t.lead}</p>
   <a href={archive} class="sp-about-primary">{t.read} <span aria-hidden="true">→</span></a>
  </div>
 </section>
 <section class="sp-about-story">
  <div class="sp-about-inner sp-about-grid">
    <div class="sp-about-manifest">
      <span aria-hidden="true" class="sp-about-manifest-mark">“</span>
      <p>{en ? 'Some feelings need more than silence.' : 'Vissa känslor behöver mer än tystnad.'}</p>
      <div class="sp-about-manifest-signature">— SPIKEN</div>
    </div>
    <div class="sp-about-copy">
     <p class="sp-about-label">{en?'THE HUMAN BEHIND THE WORDS':'MÄNNISKAN BAKOM ORDEN'}</p>
     <h2>{t.heading}</h2>
     <p>{t.p1}</p><p>{t.p2}</p>
     <a href={worlds} class="sp-about-outline">{t.explore} →</a>
    </div>
  </div>
 </section>
 <section class="sp-about-ending">
  <div class="sp-about-inner">
    <p>{t.quote}</p>
    <a href={archive}>{t.bottom} →</a>
  </div>
 </section>
</div>
<style>
/* Spiken 3.7 – ett sammanhängande bildplan för hela Om Spiken.
   Motivet lever från hero in i berättelsen i stället för att kapas vid sektionsgränsen. */
.sp-about{
 position:relative;isolation:isolate;overflow:hidden;
 min-height:85vh;background:#0d0b0b;color:#eee2d8;
 font-family:Georgia,'Times New Roman',serif;
}
.sp-about::before{
 content:"";position:absolute;z-index:-1;
 top:0;left:0;right:0;height:min(950px,105vw);min-height:710px;
 background-image:
  linear-gradient(90deg,#090808fb 0%,#090808e9 25%,#09080882 53%,#09080825 100%),
  linear-gradient(180deg,#0d0b0b00 0%,#0d0b0b13 42%,#0d0b0b9d 75%,#0d0b0b 100%),
  var(--sp-about-photo);
 background-size:cover;
 background-repeat:no-repeat;
 background-position:center,center,right 23%;
 pointer-events:none;
}
.sp-about-inner{width:min(1320px,calc(100% - 84px));margin-inline:auto}
.sp-about-hero{min-height:535px;display:flex;align-items:end;position:relative;background:transparent}
.sp-about-hero .sp-about-inner{padding:138px 0 80px}
.sp-about-eyebrow,.sp-about-label{font:700 11px/1.5 Arial,sans-serif;letter-spacing:.23em;color:#e5c3ba}
.sp-about-hero h1{font:italic 400 clamp(50px,4.8vw,73px)/1.08 Georgia,serif;letter-spacing:-.035em;max-width:650px;margin:21px 0 19px}
.sp-about-hero h1 em{color:#bd2029}
.sp-about-lead{max-width:500px;font:19px/1.62 Georgia,serif;color:#eee0d8;margin:0}
.sp-about-primary{display:inline-flex;align-items:center;justify-content:center;gap:26px;min-height:48px;padding:13px 22px;margin-top:24px;border:1px solid #b12d33;background:#921417;color:white;font:15px Arial,sans-serif;transition:background .2s}
.sp-about-primary:hover{background:#bf2029;color:white}
.sp-about-story{position:relative;background:linear-gradient(180deg,#0d0b0b00 0%,#0d0b0b99 36%,#0d0b0b 88%);padding:20px 0 62px}
.sp-about-grid{display:grid;grid-template-columns:40% 1fr;gap:7%;align-items:center}
.sp-about-manifest{border-right:1px solid #75524a;padding:22px 35px 20px 4px;min-height:235px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start}
.sp-about-manifest-mark{font:700 70px/.85 Georgia,serif;color:#bf2a34}
.sp-about-manifest p{font:italic 400 clamp(27px,3.2vw,43px)/1.3 Georgia,serif;color:#f1e4db;margin:17px 0;max-width:410px}
.sp-about-manifest-signature{font:11px Arial,sans-serif;color:#c5a09a;letter-spacing:.25em;border-top:2px solid #bc2831;padding-top:17px}
.sp-about-copy{max-width:630px;padding:20px 0}
.sp-about-copy h2{font:italic 400 clamp(35px,3.4vw,50px)/1.12 Georgia,serif;margin:17px 0 16px}
.sp-about-copy>p:not(.sp-about-label){font:17px/1.68 Georgia,serif;color:#ddc8c0;margin:0 0 17px}
.sp-about-outline{display:inline-block;border:1px solid #ae383c;padding:13px 19px;margin-top:12px;font:14px Arial,sans-serif}
.sp-about-outline:hover{background:#501a20;color:#fff}
.sp-about-ending{background:linear-gradient(180deg,#120d0d,#0d0b0b);border-top:1px solid #553731;text-align:center;padding:43px 0 64px}
.sp-about-ending p{font:italic 400 clamp(29px,3.7vw,49px)/1.2 Georgia,serif;margin:0 0 23px}
.sp-about-ending a{display:inline-block;font:14px Arial,sans-serif;border-bottom:1px solid #bf3a42;padding-bottom:7px}
@media(max-width:800px){
 .sp-about-grid{grid-template-columns:1fr;gap:14px}
 .sp-about-manifest{min-height:0;border-right:0;border-bottom:1px solid #6b4640;padding:15px 5px 26px}
 .sp-about-story{padding:5px 0 45px}
}
@media(max-width:600px){
 .sp-about-inner{width:calc(100% - 36px)}
 .sp-about::before{
  height:865px;min-height:0;
  background-image:
   linear-gradient(0deg,#0d0b0b 0%,#0d0b0bc8 33%,#0d0b0b23 83%),
   linear-gradient(90deg,#0b0808a8,transparent 75%),
   var(--sp-about-photo);
  background-position:center,center,61% top;
 }
 .sp-about-hero{min-height:625px}
 .sp-about-hero .sp-about-inner{padding:285px 0 70px}
 .sp-about-hero h1{font-size:clamp(44px,11vw,66px)}
 .sp-about-lead{font-size:17px}
 .sp-about-story{padding-top:0}
 .sp-about-manifest p{font-size:31px}
 .sp-about-copy>p:not(.sp-about-label){font-size:17px}
}
@media(prefers-reduced-motion:reduce){.sp-about-primary{transition:none}}
</style>
