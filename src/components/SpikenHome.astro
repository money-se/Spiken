---
import dikter from '../data/dikter.json';
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (name) => base + '/images/' + name + '.webp';
const home = base + (en ? '/en/' : '/');
const poems = base + (en ? '/en/poems/' : '/dikter/');
const about = base + (en ? '/en/about/' : '/om/');
const worlds = base + (en ? '/en/worlds/' : '/varldar/');
const currentPoems = en ? [] : [...dikter].slice(-3).reverse();
const copy = en ? {
  eyebrow: 'SPIKEN · WORDS UNDER THE SKIN',
  titleStart: 'Words beneath', titleEnd:'the skin.',
  lead:'Poems about love, longing, desire and the feelings we rarely dare to speak of. Written with heart, hurt and longing.',
  read:'Read my poems', about:'About Spiken',
  featured:'Find your feeling',
  author:'The man behind the words',
  authorBody:'Spiken is my way of exploring what it means to be human. Here I share poetry, thoughts and stories shaped by both darkness and light.',
  authorCta:'Get to know me',
  quote:'I do not write to be perfect, but to be human.',
  worlds:'Spiken’s Worlds', worldsText:'Beyond the poems — stories, reflections and other worlds born from words.',
  explore:'Enter the worlds', recent:'Recently published', archive:'The poetry archive',
  love:'Love', longing:'Longing', desire:'Desire', existence:'Existence',
  stories:'Stories', thoughts:'Reflections', mythology:'My Bible'
} : {
  eyebrow: 'SPIKEN · ORD UNDER HUDEN',
  titleStart: 'Ord under', titleEnd:'huden.',
  lead:'Dikter om kärlek, längtan, begär och det som bränner där ingen ser. En plats för känslor utan filter – skrivna med hjärta, sår och lust.',
  read:'Läs mina dikter', about:'Om Spiken',
  featured:'Hitta din känsla',
  author:'Mannen bakom orden',
  authorBody:'Spiken är mitt sätt att förstå, bearbeta och utforska det mänskliga. Här delar jag dikter, tankar och världar som formats av både mörker och ljus.',
  authorCta:'Läs mer om mig',
  quote:'Jag skriver inte för att vara perfekt, utan för att vara mänsklig.',
  worlds:'Spikens världar', worldsText:'Bortom dikterna finns berättelser, reflektioner och andra världar som växer fram ur orden.',
  explore:'Utforska världarna', recent:'Senast publicerat', archive:'Diktarkivet',
  love:'Kärlek', longing:'Längtan', desire:'Begär', existence:'Existens',
  stories:'Noveller', thoughts:'Reflektioner', mythology:'Min Bibel'
};
const moods = [
 {id:'love',name:copy.love,theme:'Kärlek',image:'kategori-karlek-v2'},
 {id:'longing',name:copy.longing,theme:'Längtan',image:'kategori-langtan-v2'},
 {id:'desire',name:copy.desire,theme:'Begär',image:'kategori-begar-v2'},
 {id:'existence',name:copy.existence,theme:'Existens',image:'kategori-saknad-v2'},
];
const journeys = [
 {name:copy.stories,description:en?'Human stories and their shadows.':'Berättelser om människor och deras skuggor.',anchor:'noveller',image:'varldar-bibliotek'},
 {name:copy.thoughts,description:en?'Questions about living and feeling.':'Tankar om livet, känslorna och människan.',anchor:'reflektioner',image:'dikt-arkiv-v2'},
 {name:copy.mythology,description:en?'An evolving fictional mythology.':'En skönlitterär mytologi som växer fram.',anchor:'min-bibel',image:'bakgrund-litterar'}
];
---
<div class="spiken-three" style={`--s3-hero:url("${img('spiken-3-hero')}");--s3-author:url("${img('spiken-3-forfattare')}");--s3-hero-fallback:url("${img('hero-romantik')}");--s3-author-fallback:url("${img('bakgrund-litterar')}")`}>
  <section class="s3-hero" aria-labelledby="s3-title">
    <div class="s3-hero-visual" aria-hidden="true"></div>
    <div class="s3-width s3-hero-inner">
      <div class="s3-hero-copy">
        <span class="s3-kicker">{copy.eyebrow}</span>
        <h1 id="s3-title">{copy.titleStart} <em>{copy.titleEnd}</em></h1>
        <p>{copy.lead}</p>
        <div class="s3-actions">
          <a class="s3-primary" href={poems}>{copy.read} <span aria-hidden="true">→</span></a>
          <a class="s3-secondary" href={about}>{copy.about}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="s3-feelings" aria-labelledby="s3-feelings-title" id="kanslor">
    <div class="s3-width">
      <h2 id="s3-feelings-title" class="s3-screen-reader">{copy.featured}</h2>
      <div class="s3-mood-grid">
        {moods.map(m => <a class="s3-mood" href={poems + '?tema=' + encodeURIComponent(m.theme)} aria-label={m.name}>
          <img src={img(m.image)} loading="lazy" width="640" height="430" alt="" />
          <span class="s3-mood-label">{m.name}</span>
          <span class="s3-mood-rule"></span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="s3-author" aria-labelledby="s3-author-title">
    <div class="s3-width s3-author-grid">
      <div class="s3-author-portrait" aria-hidden="true"></div>
      <div class="s3-author-text">
        <h2 id="s3-author-title">{copy.author}</h2>
        <p>{copy.authorBody}</p>
        <a class="s3-outline" href={about}>{copy.authorCta} <span aria-hidden="true">→</span></a>
      </div>
      <blockquote class="s3-quote">
        <span aria-hidden="true">“</span>
        <p>{copy.quote}</p>
        <cite>— SPIKEN</cite>
      </blockquote>
    </div>
  </section>

  {currentPoems.length > 0 && <section class="s3-latest" aria-label={copy.recent}>
    <div class="s3-width">
      <div class="s3-latest-heading"><h2>{copy.recent}</h2><a href={poems}>{copy.archive} →</a></div>
      <div class="s3-latest-list">{currentPoems.map(d => <a href={poems + d.slug + '/'}><strong>{d.titel}</strong><span>{d.tema} →</span></a>)}</div>
    </div>
  </section>}

  <section class="s3-worlds" aria-labelledby="s3-worlds-title">
    <div class="s3-width">
      <div class="s3-worlds-heading">
        <h2 id="s3-worlds-title">{copy.worlds}</h2>
        <p>{copy.worldsText}</p>
      </div>
      <div class="s3-world-grid">
        {journeys.map(j => <a class="s3-world-card" href={worlds+'#'+j.anchor}>
          <img src={img(j.image)} alt="" loading="lazy" width="560" height="350"/>
          <div class="s3-world-caption"><h3>{j.name}</h3><p>{j.description}</p></div>
          <span class="s3-world-arrow" aria-hidden="true">→</span>
        </a>)}
      </div>
      <div class="s3-worlds-more"><a href={worlds}>{copy.explore} →</a></div>
    </div>
  </section>
</div>
<style>
.spiken-three{
 --s3-accent:#bd1c25;--s3-line:#60433e;--s3-cream:#eee2d8;
 background:#0d0b0b;color:var(--s3-cream);
 font-family:Georgia,'Times New Roman',serif;isolation:isolate;overflow:hidden
}
.spiken-three .s3-width{width:min(1320px,calc(100% - 84px));margin-inline:auto}
.s3-hero{position:relative;isolation:isolate;min-height:510px;display:flex;align-items:center;background:#0d0b0b}
.s3-hero-visual{position:absolute;inset:0;z-index:-2;background-image:linear-gradient(90deg,#08090afa 0%,#090809eb 27%,#09080978 48%,#08090a26 76%,#08090a24 100%),var(--s3-hero),var(--s3-hero-fallback);background-position:center,right center,right center;background-repeat:no-repeat;background-size:cover}
.s3-hero::after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(180deg,transparent 70%,#0d0b0ba1 100%);pointer-events:none}
.s3-hero-inner{padding-block:86px}
.s3-hero-copy{max-width:540px}
.s3-kicker{font:700 11px/1.5 Arial,sans-serif;letter-spacing:.24em;color:#ddc6bd}
.s3-hero h1{font:italic 400 clamp(56px,6.5vw,100px)/1.03 Georgia,serif;letter-spacing:-.035em;margin:26px 0 25px;text-wrap:balance}
.s3-hero h1 em{color:#bf2029;font-weight:400}
.s3-hero-copy>p{font-size:clamp(18px,1.6vw,23px);line-height:1.62;color:#f0e2db;margin:0;max-width:500px}
.s3-actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:30px}
.s3-primary,.s3-secondary,.s3-outline{display:inline-flex;align-items:center;justify-content:center;gap:21px;min-height:48px;padding:12px 23px;font:16px Arial,sans-serif;transition:background .2s,border-color .2s}
.s3-primary{background:#921417;color:#fff;border:1px solid #ad2429}
.s3-primary:hover{background:#bf2227;color:white}
.s3-secondary,.s3-outline{background:#100d0dc9;border:1px solid #aaa09a;color:#f2e6db}
.s3-secondary:hover,.s3-outline:hover{border-color:#eee;color:white;background:#382322}
.s3-feelings{position:relative;background:linear-gradient(180deg,#151110,#0d0b0b);padding:22px 0 48px}
.s3-feelings:before{content:"";height:1px;background:linear-gradient(90deg,transparent,#7d5e4d,transparent);position:absolute;left:0;right:0;top:0}
.s3-screen-reader{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.s3-mood-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}
.s3-mood{display:block;position:relative;isolation:isolate;aspect-ratio:1.93;overflow:hidden;border:1px solid #59423d;background:#241918}
.s3-mood img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .35s;z-index:-2}
.s3-mood:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,#060505d8,transparent 83%)}
.s3-mood-label{position:absolute;bottom:30px;left:23px;font:italic clamp(28px,3vw,47px)/1 Georgia,serif;color:#f4eae2}
.s3-mood-rule{position:absolute;bottom:15px;left:23px;width:75px;height:2px;background:#b41b23}
.s3-mood:hover img{transform:scale(1.06)}
.s3-author{padding:0 0 50px;background:#0d0b0b}
.s3-author-grid{display:grid;grid-template-columns:32% 34% 1fr;gap:30px;align-items:center}
.s3-author-portrait{min-height:295px;align-self:stretch;background-image:linear-gradient(90deg,transparent 70%,#0d0b0b5c),var(--s3-author),var(--s3-author-fallback);background-position:center;background-size:cover;background-repeat:no-repeat;filter:grayscale(.55)}
.s3-author-text{padding:22px 0}
.s3-author-text h2{font:italic 400 clamp(33px,3.4vw,51px)/1.16 Georgia,serif;margin:0 0 16px;letter-spacing:-.02em}
.s3-author-text p{font:18px/1.65 Georgia,serif;color:#e1d1c9;margin:0 0 20px}
.s3-outline{font:15px Arial,sans-serif;border-color:#a6262b;padding:12px 19px;min-height:43px}
.s3-quote{border-left:1px solid #7f5d56;margin:0;padding:20px 0 20px 48px;text-align:center;min-width:0}
.s3-quote>span{display:block;color:#bc1f29;font:700 64px/0.8 Georgia,serif;margin-bottom:18px}
.s3-quote p{font:italic clamp(20px,2.2vw,31px)/1.45 Georgia,serif;color:#f1e2dc;margin:0 0 14px}
.s3-quote cite{font:12px Arial,sans-serif;letter-spacing:.3em;font-style:normal;color:#c1a8a0}
.s3-latest{background:#141010;padding:30px 0 55px}
.s3-latest-heading{display:flex;justify-content:space-between;align-items:baseline;gap:16px}.s3-latest-heading h2{font:italic 35px Georgia,serif;margin:0 0 15px}.s3-latest-heading a{border-bottom:1px solid #a1272b}
.s3-latest-list{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.s3-latest-list a{padding:20px;border:1px solid #573a3a;display:flex;gap:20px;align-items:center;justify-content:space-between}
.s3-latest-list strong{font:italic 23px Georgia,serif}.s3-latest-list span{font:12px Arial,sans-serif;color:#c79c98}
.s3-worlds{background:linear-gradient(180deg,#120e0d,#0d0b0b);padding:42px 0 62px;border-top:1px solid #46352f}
.s3-worlds-heading{text-align:center;margin-bottom:31px}
.s3-worlds-heading h2{font:italic 400 clamp(40px,4.5vw,64px)/1.2 Georgia,serif;margin:0 0 12px}
.s3-worlds-heading p{font:18px/1.55 Georgia,serif;color:#d4bcb4;margin:0}
.s3-world-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.s3-world-card{position:relative;min-height:250px;overflow:hidden;isolation:isolate;display:flex;align-items:flex-end;border:1px solid #67534b;color:#fff}
.s3-world-card img{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .35s}
.s3-world-card:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,#0b0808f4,transparent 95%)}
.s3-world-card:hover img{transform:scale(1.05)}
.s3-world-caption{padding:25px 24px}
.s3-world-caption h3{font:italic 32px/1.2 Georgia,serif;margin:0 0 9px}
.s3-world-caption p{max-width:270px;font:14px/1.5 Arial,sans-serif;margin:0;color:#e8d7ce}
.s3-world-arrow{position:absolute;right:16px;bottom:20px;font:26px Arial,sans-serif}
.s3-worlds-more{text-align:center;padding-top:27px}.s3-worlds-more a{display:inline-block;border-bottom:1px solid #bd3136;font:15px Arial,sans-serif;padding-bottom:9px}
@media(max-width:1040px){.s3-author-grid{grid-template-columns:33% 1fr;gap:25px}.s3-quote{grid-column:2;border-left:0;border-top:1px solid #5d403b;padding:23px 0 0}.s3-quote p{font-size:21px}.s3-mood-label{font-size:31px}.s3-hero{min-height:530px}}
@media(max-width:700px){
 .spiken-three .s3-width{width:calc(100% - 36px)}
 .s3-hero{min-height:650px;align-items:flex-end}
 .s3-hero-visual{background-image:linear-gradient(0deg,#09080afa 0%,#09080ab8 44%,#09080a1c 90%),var(--s3-hero),var(--s3-hero-fallback);background-position:center,63% center,63% center}
 .s3-hero-inner{padding:270px 0 55px}
 .s3-hero h1{font-size:clamp(54px,12.3vw,78px);max-width:480px}
 .s3-hero-copy>p{font-size:18px}
 .s3-actions{gap:10px}.s3-primary,.s3-secondary{font-size:14px;padding:11px 16px}
 .s3-mood-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
 .s3-mood{aspect-ratio:1.5}.s3-mood-label{font-size:29px;left:13px;bottom:23px}.s3-mood-rule{left:13px;bottom:10px;width:47px}
 .s3-feelings{padding:13px 0 35px}
 .s3-author{padding-bottom:30px}.s3-author-grid{grid-template-columns:1fr;gap:0}
 .s3-author-portrait{height:260px;min-height:0;background-position:center 35%}
 .s3-author-text{padding:28px 4px}
 .s3-author-text h2{font-size:39px}.s3-author-text p{font-size:17px}
 .s3-quote{grid-column:1;padding:23px 5px}
 .s3-worlds{padding:35px 0 52px}.s3-world-grid{grid-template-columns:1fr;gap:11px}
 .s3-world-card{min-height:205px}.s3-worlds-heading p{font-size:16px}
 .s3-latest-list{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){.s3-mood img,.s3-world-card img,.s3-primary,.s3-secondary{transition:none}}
</style>
