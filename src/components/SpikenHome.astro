---
import dikter from '../data/dikter.json';
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = name => base + '/images/' + name + '.webp';
const poemPath = base + (en ? '/en/poems/' : '/dikter/');
const worldPath = base + (en ? '/en/worlds/' : '/varldar/');
const latest = en ? [] : [...dikter].slice(-3).reverse();
const t = en ? {
 eyebrow:'WORDS UNDER THE SKIN',
 title:'For everything you never got to say.',
 intro:'Poetry about love, longing and everything that lingers.',
 read:'Read the poems',
 feelings:'Find the words for your feelings.',
 feelingsSub:'Where would you like to begin?',
 poems:'From the archive',
 poemsSub:'Words to return to.',
 empty:'The poetry archive is taking shape. Here, the poems will soon find their place.',
 explore:'Explore the archive',
 worlds:'Spiken’s Worlds',
 worldsText:'Stories, reviews, dark poetry, reflections and mythology. Another side of the same author.',
 worldsLink:'Explore the worlds',
} : {
 eyebrow:'ORD UNDER HUDEN',
 title:'För allt du aldrig fick sagt.',
 intro:'Dikter om kärlek, längtan och allt som dröjer sig kvar.',
 read:'Läs dikterna',
 feelings:'Hitta orden för din känsla.',
 feelingsSub:'Var vill du börja?',
 poems:'Ur diktarkivet',
 poemsSub:'Ord att återvända till.',
 empty:'Diktarkivet tar form. Här får dikterna snart sin plats.',
 explore:'Utforska arkivet',
 worlds:'Spikens världar',
 worldsText:'Noveller, recensioner, mörk poesi, reflektioner och mytologi. En annan sida av samma författare.',
 worldsLink:'Utforska världarna',
};
const feelings = [
 {sv:'Kärlek',en:'Love',theme:'Kärlek'},
 {sv:'Längtan',en:'Longing',theme:'Längtan'},
 {sv:'Begär',en:'Desire',theme:'Begär'},
 {sv:'Hjärtesorg',en:'Heartbreak',theme:'Hjärtesorg'},
 {sv:'Saknad',en:'Missing',theme:'Saknad'},
];
---
<div class="spiken-simple" style={`--sp-hero:url("${img('hero-romantik')}");--sp-archive:url("${img('dikt-arkiv-v2')}");--sp-library:url("${img('varldar-bibliotek')}")`}>
  <section class="sp-hero" aria-labelledby="sp-hero-title">
    <div class="sp-wrap sp-hero-inner">
      <p class="sp-eyebrow">{t.eyebrow}</p>
      <h1 id="sp-hero-title">{t.title}</h1>
      <p class="sp-lead">{t.intro}</p>
      <a class="sp-cta" href={poemPath}>{t.read}<span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="sp-feelings" aria-labelledby="sp-feelings-title">
    <div class="sp-wrap sp-feelings-inner">
      <div class="sp-section-intro">
        <h2 id="sp-feelings-title">{t.feelings}</h2>
        <p>{t.feelingsSub}</p>
      </div>
      <nav class="sp-feeling-list" aria-label={en ? 'Poetry by feeling' : 'Dikter efter känsla'}>
        {feelings.map(f => <a href={poemPath + '?tema=' + encodeURIComponent(f.theme)}><span>{en ? f.en : f.sv}</span><span class="sp-arrow" aria-hidden="true">↗</span></a>)}
      </nav>
    </div>
  </section>

  <section class="sp-archive" aria-labelledby="sp-archive-title">
    <div class="sp-wrap sp-archive-inner">
      <div class="sp-archive-image" role="img" aria-label={en ? 'Handwritten letters and a burgundy flower by candlelight' : 'Handskrivna brev och en vinröd blomma i levande ljus'}></div>
      <div class="sp-archive-text">
        <h2 id="sp-archive-title">{t.poems}</h2>
        <p class="sp-section-sub">{t.poemsSub}</p>
        {latest.length > 0 ?
          <div class="sp-poems">
            {latest.map(d => <a href={poemPath+d.slug+'/'}><span>{d.titel}</span><small>{d.tema} ↗</small></a>)}
          </div>
          : <p class="sp-empty">{t.empty}</p>}
        <a class="sp-text-link" href={poemPath}>{t.explore} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="sp-worlds" aria-labelledby="sp-worlds-title">
    <div class="sp-wrap sp-worlds-inner">
      <h2 id="sp-worlds-title">{t.worlds}</h2>
      <p>{t.worldsText}</p>
      <a class="sp-text-link" href={worldPath}>{t.worldsLink} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</div>
<style>
.spiken-simple{background:#12080d;color:#f5e8e5;font-family:Georgia,'Times New Roman',serif}
.sp-wrap{width:min(1120px,calc(100% - 72px));margin-inline:auto}
.sp-hero{min-height:660px;display:flex;align-items:center;background:linear-gradient(90deg,#10070dfb 0%,#10070de6 30%,#10070d79 58%,#10070d1e 100%),var(--sp-hero) center right/cover no-repeat}
.sp-hero-inner{padding-block:105px}
.sp-eyebrow{margin:0 0 22px;color:#d7a8ae;font:600 11px/1.5 Arial,sans-serif;letter-spacing:.24em}
.sp-hero h1{max-width:650px;margin:0;font:400 clamp(55px,6.6vw,95px)/1.07 Georgia,serif;letter-spacing:-.044em;text-wrap:balance}
.sp-lead{max-width:480px;margin:27px 0 32px;color:#ead5d3;font:21px/1.6 Georgia,serif}
.sp-cta{display:inline-flex;align-items:center;gap:35px;background:#78293b;color:#fff3f0;padding:16px 23px;font:14px Arial,sans-serif;transition:background .2s}
.sp-cta:hover{background:#a13d54;color:#fff;text-decoration:none}
.sp-feelings{padding:100px 0;background:#160a10}
.sp-feelings-inner{display:grid;grid-template-columns:1fr 1fr;gap:9%;align-items:start}
.sp-section-intro h2,.sp-archive h2,.sp-worlds h2{font:400 clamp(39px,4.5vw,62px)/1.16 Georgia,serif;letter-spacing:-.03em;margin:0}
.sp-section-intro p,.sp-section-sub{font:italic 20px/1.6 Georgia,serif;color:#cbaeb2;margin:19px 0 0}
.sp-feeling-list{display:flex;flex-direction:column;border-top:1px solid #5f3943}
.sp-feeling-list a{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:18px 5px;border-bottom:1px solid #5f3943;color:#f2dddb;font:italic clamp(24px,2.5vw,33px) Georgia,serif;transition:padding .2s,color .2s}
.sp-feeling-list a:hover{padding-inline:12px;color:#e9acb7;text-decoration:none}
.sp-arrow{font:20px Arial,sans-serif;color:#c78996}
.sp-archive{padding:100px 0;background:#10070b}
.sp-archive-inner{display:grid;grid-template-columns:.95fr 1fr;align-items:center;gap:8%}
.sp-archive-image{min-height:380px;background:var(--sp-archive) center/cover no-repeat}
.sp-archive-text{max-width:500px}
.sp-archive-text .sp-section-sub{margin:16px 0 25px}
.sp-empty{max-width:420px;color:#ddc5c7;font:18px/1.7 Georgia,serif}
.sp-text-link{display:inline-block;margin-top:20px;padding-bottom:8px;border-bottom:1px solid #ae6474;color:#f1d3d7;font:14px Arial,sans-serif}
.sp-text-link:hover{color:#fff}
.sp-poems{border-top:1px solid #5f3943;margin:30px 0 5px}
.sp-poems a{display:flex;align-items:baseline;justify-content:space-between;gap:15px;border-bottom:1px solid #5f3943;padding:14px 0;font:italic 23px Georgia,serif}
.sp-poems small{color:#c696a2;font:12px Arial,sans-serif}
.sp-worlds{display:flex;align-items:center;min-height:380px;padding:82px 0;background:linear-gradient(90deg,#10080deb 0%,#10080dbf 50%,#10080d69 100%),var(--sp-library) center/cover no-repeat}
.sp-worlds-inner{max-width:1120px}
.sp-worlds h2,.sp-worlds p{max-width:580px}
.sp-worlds p{font:19px/1.65 Georgia,serif;color:#e0c5cb;margin:18px 0 10px}
@media(max-width:850px){.sp-hero{background-position:65% center}.sp-feelings-inner{gap:6%}}
@media(max-width:700px){
.sp-wrap{width:calc(100% - 40px)}
.sp-hero{min-height:610px;align-items:flex-end;background-image:linear-gradient(0deg,#10070df7 0%,#10070d94 48%,#10070d4a 100%),linear-gradient(90deg,#10070d88,transparent),var(--sp-hero);background-position:center,center,68% center;background-size:cover}
.sp-hero-inner{padding-block:100px 67px}
.sp-hero h1{font-size:clamp(47px,11vw,69px);max-width:520px}
.sp-lead{font-size:18px}
.sp-feelings{padding:70px 0}
.sp-feelings-inner{grid-template-columns:1fr;gap:30px}
.sp-feeling-list a{padding-block:14px}
.sp-archive{padding:65px 0}
.sp-archive-inner{grid-template-columns:1fr;gap:33px}
.sp-archive-image{min-height:250px}
.sp-worlds{min-height:340px;padding:65px 0}
.sp-worlds p{font-size:17px}
}
@media(prefers-reduced-motion:reduce){.sp-feeling-list a,.sp-cta{transition:none}}
</style>
