---
import dikter from '../data/dikter.json';
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const poemPath = base + (en ? '/en/poems/' : '/dikter/');
const worldPath = base + (en ? '/en/worlds/' : '/varldar/');
const latest = en ? [] : [...dikter].slice(-3).reverse();
const t = en ? {
  eyebrow:'SPIKEN · WORDS UNDER THE SKIN',
  title:'For everything you never got to say.',
  intro:'Poetry about love, longing and everything that lingers.',
  read:'Read the poems',
  feelings:'It begins with a feeling.',
  feelingsSub:'Some feelings are easier to recognize than explain.',
  poems:'Then come the words.',
  poemsSub:'A place for everything we could not say.',
  empty:'The poetry archive is taking shape. Soon the words will find their place here.',
  explore:'Explore the archive',
  worlds:'Spiken’s Worlds',
  worldsText:'The words do not end here. Discover stories, reflections and darker worlds beyond the poems.',
  worldsLink:'Explore the worlds'
} : {
  eyebrow:'SPIKEN · ORD UNDER HUDEN',
  title:'För allt du aldrig fick sagt.',
  intro:'Dikter om kärlek, längtan och allt som dröjer sig kvar.',
  read:'Läs dikterna',
  feelings:'Allt börjar med en känsla.',
  feelingsSub:'Vissa känslor är lättare att känna än att förklara.',
  poems:'Sedan kommer orden.',
  poemsSub:'En plats för det vi aldrig fick sagt.',
  empty:'Diktarkivet tar form. Snart får orden sin plats här.',
  explore:'Utforska arkivet',
  worlds:'Spikens världar',
  worldsText:'Orden slutar inte här. Upptäck berättelser, reflektioner och mörkare världar bortom dikterna.',
  worldsLink:'Utforska världarna'
};
const feelings = [
  {sv:'Kärlek',en:'Love',theme:'Kärlek'},
  {sv:'Längtan',en:'Longing',theme:'Längtan'},
  {sv:'Begär',en:'Desire',theme:'Begär'},
  {sv:'Hjärtesorg',en:'Heartbreak',theme:'Hjärtesorg'},
  {sv:'Saknad',en:'Missing',theme:'Saknad'}
];
---
<div class="spiken-universe" style={`--universe-image:url("${base}/images/spiken-helbakgrund.webp");--universe-fallback:url("${base}/images/bakgrund-litterar.webp")`}>
  <section class="su-hero" aria-labelledby="su-title">
    <div class="su-wrap su-hero-content">
      <p class="su-eyebrow">{t.eyebrow}</p>
      <h1 id="su-title">{t.title}</h1>
      <p class="su-lead">{t.intro}</p>
      <a class="su-main-link" href={poemPath}>{t.read} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="su-feelings" aria-labelledby="su-feelings-title">
    <div class="su-wrap su-feelings-layout">
      <div class="su-heading">
        <span class="su-step">{en ? '01 · FEEL' : '01 · KÄNN'}</span>
        <h2 id="su-feelings-title">{t.feelings}</h2>
        <p>{t.feelingsSub}</p>
      </div>
      <nav class="su-feeling-links" aria-label={en ? 'Poetry by feeling' : 'Dikter efter känsla'}>
        {feelings.map(f => <a href={poemPath + '?tema=' + encodeURIComponent(f.theme)}><span>{en ? f.en : f.sv}</span><span aria-hidden="true">↗</span></a>)}
      </nav>
    </div>
  </section>

  <section class="su-archive" aria-labelledby="su-archive-title">
    <div class="su-wrap su-archive-layout">
      <div class="su-archive-text">
        <span class="su-step">{en ? '02 · READ' : '02 · LÄS'}</span>
        <h2 id="su-archive-title">{t.poems}</h2>
        <p class="su-subtitle">{t.poemsSub}</p>
        {latest.length > 0 ?
          <div class="su-poem-links">{latest.map(d => <a href={poemPath + d.slug + '/'}><span>{d.titel}</span><small>{d.tema} ↗</small></a>)}</div> :
          <p class="su-empty">{t.empty}</p>
        }
        <a class="su-underlined" href={poemPath}>{t.explore} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="su-worlds" aria-labelledby="su-worlds-title">
    <div class="su-wrap su-worlds-content">
      <span class="su-step">{en ? '03 · EXPLORE' : '03 · UTFORSKA'}</span>
      <h2 id="su-worlds-title">{t.worlds}</h2>
      <p>{t.worldsText}</p>
      <a class="su-underlined" href={worldPath}>{t.worldsLink} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</div>
<style>
.spiken-universe{--su-ink:#13070d;--su-paper:#f4e8e2;--su-muted:#e2c6c8;position:relative;isolation:isolate;overflow:hidden;background:#16080e;color:var(--su-paper);font-family:Georgia,'Times New Roman',serif}
.spiken-universe::before{content:"";position:absolute;inset:0;z-index:-2;pointer-events:none;background-image:var(--universe-image),var(--universe-fallback);background-repeat:no-repeat;background-position:center top;background-size:100% 100%;opacity:1}
.spiken-universe::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(90deg,#11060cd9 0%,#11060c9c 42%,#11060c43 80%,#11060c34 100%),linear-gradient(180deg,#11060c66 0%,transparent 15%,#1a0a14a8 37%,#1a0a14ad 58%,transparent 77%,#15090fe0 100%)}
.su-wrap{width:min(1120px,calc(100% - 72px));margin-inline:auto}
.su-hero,.su-feelings,.su-archive,.su-worlds{position:relative;background:transparent}
.su-hero{min-height:660px;display:flex;align-items:center}
.su-hero-content{padding:100px 0 105px}
.su-eyebrow,.su-step{font:700 11px/1.6 Arial,sans-serif;letter-spacing:.22em;color:#e5aebc}
.su-eyebrow{margin:0 0 23px}
.su-hero h1{max-width:680px;font:400 clamp(57px,6.9vw,98px)/1.08 Georgia,serif;letter-spacing:-.045em;text-wrap:balance;margin:0}
.su-lead{max-width:470px;color:#f3dfe0;font:21px/1.6 Georgia,serif;margin:29px 0 31px}
.su-main-link{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:15px 23px;background:#7c2d42;color:#fff4ef;font:14px Arial,sans-serif;transition:background .2s ease}
.su-main-link:hover{background:#a03d55;color:white;text-decoration:none}
.su-feelings{padding:85px 0 100px}
.su-feelings-layout{display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:start}
.su-step{display:block;margin-bottom:23px}
.su-heading h2,.su-archive h2,.su-worlds h2{font:400 clamp(39px,4.6vw,63px)/1.14 Georgia,serif;letter-spacing:-.035em;margin:0;text-wrap:balance}
.su-heading p,.su-subtitle{font:italic 20px/1.6 Georgia,serif;color:var(--su-muted);margin:20px 0}
.su-feeling-links{display:flex;flex-direction:column;background:#17081052;padding:0 20px;border-top:1px solid #c58d9557;border-bottom:1px solid #c58d9557;backdrop-filter:blur(4px)}
.su-feeling-links a{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 0;border-bottom:1px solid #c58d953a;color:#fff0e9;font:italic clamp(24px,2.5vw,33px) Georgia,serif}
.su-feeling-links a:last-child{border-bottom:0}
.su-feeling-links a span:last-child{font:19px Arial,sans-serif;color:#d9a4ad}
.su-feeling-links a:hover{color:#e8aebc;text-decoration:none}
.su-archive{min-height:460px;display:flex;align-items:center;padding:70px 0 115px}
.su-archive-layout{display:grid;grid-template-columns:1fr 1fr;gap:6%}
.su-archive-text{max-width:510px;grid-column:2;padding:25px 27px 35px;background:linear-gradient(90deg,#180a13c7,#180a13a0);backdrop-filter:blur(4px);border-left:1px solid #b77a864b}
.su-archive .su-subtitle{margin:17px 0 23px}
.su-empty{max-width:430px;font:18px/1.7 Georgia,serif;color:#f0d7d7}
.su-underlined{display:inline-flex;align-items:center;gap:20px;margin-top:20px;padding-bottom:8px;border-bottom:1px solid #c07f8d;color:#fff0eb;font:14px Arial,sans-serif}
.su-underlined:hover{color:#f3bac6}
.su-poem-links{border-top:1px solid #946270;margin-top:25px}
.su-poem-links a{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid #946270;padding:14px 0;font:italic 22px Georgia,serif}
.su-poem-links small{font:12px Arial,sans-serif;color:#f0b7c3}
.su-worlds{min-height:470px;display:flex;align-items:center;padding:120px 0 150px}
.su-worlds::after{content:"";position:absolute;left:0;right:0;bottom:0;height:190px;pointer-events:none;background:linear-gradient(180deg,transparent,#160a10)}
.su-worlds-content{position:relative;z-index:1}
.su-worlds h2,.su-worlds p{max-width:610px}
.su-worlds p{color:#f3dadd;font:20px/1.65 Georgia,serif;margin:20px 0 8px}
@media(max-width:850px){.su-feelings-layout{gap:6%}}
@media(max-width:700px){
 .su-wrap{width:calc(100% - 40px)}
 .spiken-universe::before{background-size:100% 100%;background-position:center top}
 .spiken-universe::after{background:linear-gradient(90deg,#10060bd4,#10060b8a),linear-gradient(180deg,#10060b69,transparent 13%,#160812a0 42%,#160812a8 65%,transparent 82%,#160a10e8)}
 .su-hero{min-height:630px;align-items:end}
 .su-hero-content{padding:130px 0 70px}
 .su-hero h1{font-size:clamp(47px,11.2vw,74px)}
 .su-lead{font-size:18px}
 .su-feelings{padding:70px 0 80px}
 .su-feelings-layout{grid-template-columns:1fr;gap:28px}
 .su-feeling-links{padding:0 15px}
 .su-feeling-links a{padding:13px 0}
 .su-archive{min-height:430px;padding:75px 0}
 .su-archive-layout{grid-template-columns:1fr}
 .su-archive-text{grid-column:1;padding:25px 22px;background:#170810af}
 .su-worlds{min-height:415px;padding:95px 0 115px}
 .su-worlds p{font-size:18px}
 .su-worlds::after{height:110px}
}
@media(prefers-reduced-motion:reduce){.su-main-link{transition:none}}
</style>
