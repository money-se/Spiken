---
import {getReviews} from '../lib/reviews.js';
const {lang='sv'}=Astro.props;
const en=lang==='en';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const root=base+(en?'/en/worlds/recensioner/':'/varldar/recensioner/');
const reviews=getReviews(lang);
const kinds=[...new Set(reviews.map(x=>x.subjectType))].sort((a,b)=>a.localeCompare(b,lang));
const t=en?{
 eyebrow:'THE REVIEW ARCHIVE',title:'What stays after the final page.',intro:'Not every story lets go when it ends. Here, I write about what moved me, what challenged me and what failed to reach me.',
 all:'All types',count:'reviews',read:'Read my review',minutes:'min read',subject:'Reviewed work',
 empty:'The first review is still unwritten.',emptyBody:'This space is ready for thoughtful, personal reviews. No ratings or opinions appear before I have actually written and approved them.'
}:{
 eyebrow:'RECENSIONSARKIVET',title:'Det som stannar efter sista sidan.',intro:'Alla berättelser släpper inte taget när de är slut. Här skriver jag om det som berörde mig, det som skavde och det som aldrig riktigt nådde fram.',
 all:'Alla typer',count:'recensioner',read:'Läs recensionen',minutes:'min läsning',subject:'Recenserat verk',
 empty:'Den första recensionen är ännu oskriven.',emptyBody:'Här finns plats för personliga och genomarbetade omdömen. Inga betyg eller åsikter visas innan jag faktiskt har skrivit och godkänt dem.'
};
---
<section class="rv-archive" id="recensionsarkiv" aria-labelledby="rv-heading">
  <div class="rv-wrap">
    <header class="rv-heading">
      <p class="rv-kicker">{t.eyebrow}</p>
      <h2 id="rv-heading">{t.title}</h2>
      <p>{t.intro}</p>
    </header>
    {reviews.length>0 ? <>
      <div class="rv-tools">
        <span>{reviews.length} {t.count}</span>
        {kinds.length>1&&<div class="rv-filters" role="group" aria-label={en?'Filter reviews':'Filtrera recensioner'}>
          <button type="button" class="rv-filter" aria-pressed="true" data-kind="">{t.all}</button>
          {kinds.map(kind=><button type="button" class="rv-filter" aria-pressed="false" data-kind={kind}>{kind}</button>)}
        </div>}
      </div>
      <div class="rv-grid">
      {reviews.map(review=><article class="rv-card" data-kind={review.subjectType}>
        <a href={root+encodeURIComponent(review.slug)+'/'} aria-label={review.title}>
          <div class="rv-card-art" style={`--rv-cover:url("${base}/images/${review.image}")`} aria-hidden="true"></div>
          <div class="rv-card-body">
            <div class="rv-card-meta"><span>{review.subjectType}{review.genre?' · '+review.genre:''}</span>{review.rating!==null&&<span class="rv-card-score" aria-label={(en?'My rating':'Mitt betyg')+': '+review.rating+'/5'}>{review.rating}/5 ★</span>}</div>
            <h3>{review.title}</h3>
            {review.subjectTitle&&<p class="rv-subject">{t.subject}: {review.subjectTitle}{review.creator?', '+review.creator:''}</p>}
            <p class="rv-card-summary">{review.summary}</p>
            <span class="rv-duration">{review.minutes} {t.minutes}</span>
            <span class="rv-read">{t.read} <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      </article>)}
      </div>
    </> : <div class="rv-empty">
      <span aria-hidden="true">✦</span>
      <h3>{t.empty}</h3>
      <p>{t.emptyBody}</p>
    </div>}
  </div>
</section>
{kinds.length>1&&<script>
  const filterButtons=[...document.querySelectorAll('.rv-filter')];
  const cards=[...document.querySelectorAll('.rv-card')];
  for(const button of filterButtons)button.addEventListener('click',()=>{
    const value=button.dataset.kind||'';
    for(const filter of filterButtons)filter.setAttribute('aria-pressed',String(filter===button));
    for(const card of cards)card.hidden=!!value&&card.dataset.kind!==value;
  });
</script>}
<style>
.rv-archive{background:radial-gradient(ellipse at 90% 9%,#441d1c36,transparent 51%),#0d0b0b;color:#eee2d8;padding:68px 0 92px}
.rv-wrap{width:min(1320px,calc(100% - 84px));margin:auto}
.rv-heading{max-width:790px;margin:0 0 42px}
.rv-kicker{font:700 11px/1.6 Arial,sans-serif;letter-spacing:.2em;color:#d6a19a;margin:0 0 16px}
.rv-heading h2{font:italic 400 clamp(37px,4vw,56px)/1.15 Georgia,serif;margin:0 0 20px}
.rv-heading>p:last-child{font:17px/1.78 Georgia,serif;color:#dec8c0}
.rv-tools{display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;align-items:center;border-top:1px solid #6a4740;padding:22px 0;color:#cbb0a8;font:13px Arial,sans-serif}
.rv-filters{display:flex;gap:8px;flex-wrap:wrap}
.rv-filter{padding:9px 14px;border:1px solid #6c4a44;background:#201517;color:#e8d0c8;font:12px Arial,sans-serif;cursor:pointer}
.rv-filter:hover,.rv-filter[aria-pressed=true]{background:#812028;border-color:#ca7173;color:white}
.rv-filter:focus-visible,.rv-card a:focus-visible{outline:2px solid #ecc0b7;outline-offset:4px}
.rv-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.rv-card{border:1px solid #60433f;background:#191112;overflow:hidden}
.rv-card[hidden]{display:none}
.rv-card:hover{border-color:#ac6564}
.rv-card>a{display:flex;height:100%;flex-direction:column;color:#f6e9e2;text-decoration:none}
.rv-card-art{height:220px;background-image:linear-gradient(0deg,#0d090a9e,transparent 65%),var(--rv-cover);background-size:cover;background-position:center}
.rv-card-body{padding:25px;display:flex;flex:1;flex-direction:column;gap:12px}
.rv-card-meta{display:flex;justify-content:space-between;gap:12px;align-items:center;color:#d6a59c;text-transform:uppercase;letter-spacing:.12em;font:700 10px Arial,sans-serif}
.rv-card-score{color:#efd3a0;border:1px solid #73564a;padding:5px 7px;white-space:nowrap}
.rv-card h3{font:italic 400 29px/1.2 Georgia,serif;margin:0}
.rv-subject{font:13px/1.5 Arial,sans-serif;color:#d4b9ae;margin:0}
.rv-card-summary{font:15px/1.65 Georgia,serif;color:#e0cbc2;margin:0}
.rv-duration{margin-top:auto;padding-top:13px;color:#c7a9a0;font:12px Arial,sans-serif}
.rv-read{align-self:start;color:#efd0c8;font:13px Arial,sans-serif;border-bottom:1px solid #b9585f;padding-bottom:7px}
.rv-empty{max-width:820px;margin:0 auto;background:linear-gradient(135deg,#271719,#130e10);border:1px solid #674540;padding:58px 25px;text-align:center}
.rv-empty>span{font-size:34px;color:#bc5b60}
.rv-empty h3{font:italic 400 clamp(27px,3vw,38px)/1.25 Georgia,serif;margin:14px 0 19px}
.rv-empty p{font:16px/1.8 Georgia,serif;color:#dbc4bd;max-width:580px;margin:auto}
@media(max-width:940px){.rv-wrap{width:calc(100% - 40px)}.rv-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){.rv-wrap{width:calc(100% - 36px)}.rv-archive{padding:40px 0 65px}.rv-grid{grid-template-columns:1fr}}
</style>