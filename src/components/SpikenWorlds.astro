---
import {worldSections} from '../lib/worlds.js';
const {lang='sv'}=Astro.props;
const en=lang==='en';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const home=base+(en?'/en/':'/');
const poems=base+(en?'/en/poems/':'/dikter/');
const worldRoot=base+(en?'/en/worlds/':'/varldar/');
const t=en?{
 kicker:'SPIKEN · THE WORLDS BEYOND',first:'Spiken’s',last:'worlds.',
 intro:'What is real? What makes us human? Beyond the poems, thoughts drift into stories, questions and worlds without simple answers.',
 explore:'Explore the worlds',sections:'Where thoughts become worlds',soon:'A world in progress',back:'Back to the poems',enter:'Enter this world',direction:'Choose a door. Every world has its own voice, but all belong to Spiken.',
 novels:'Stories',novelText:'Human stories, the forbidden and the uncanny.',
 reflections:'Reflections',reflectionText:'Thoughts on being human, on love and consciousness.',
 bible:'My Bible',bibleText:'A fictional mythology and a world that continues to grow.',
 reviews:'Reviews',reviewText:'Books, stories and experiences that leave a mark.',
 dark:'Dark poetry',darkText:'The parts of life that are harder to put into words.'
}:{
 kicker:'SPIKEN · BORTOM ORDEN',first:'Spikens',last:'världar.',
 intro:'Vad är verkligt? Vad gör oss mänskliga? Bortom dikterna driver tankarna vidare mot berättelser, frågor och världar utan enkla svar.',
 explore:'Utforska världarna',sections:'Där tankar blir världar',soon:'En värld under uppbyggnad',back:'Tillbaka till dikterna',enter:'Kliv in i världen',direction:'Välj en dörr. Varje värld har sin egen röst, men alla hör till Spiken.',
 novels:'Noveller',novelText:'Berättelser om det mänskliga, det förbjudna och det märkliga.',
 reflections:'Reflektioner',reflectionText:'Tankar om livet, kärleken och medvetandet.',
 bible:'Min Bibel',bibleText:'En skönlitterär mytologi och en värld som fortsätter växa.',
 reviews:'Recensioner',reviewText:'Litteratur, berättelser och upplevelser som lämnar spår.',
 dark:'Mörk poesi',darkText:'De delar av livet som är svårare att sätta ord på.'
};
const visibleWorlds=worldSections.filter(world=>world.public!==false);
const cards=visibleWorlds.slice(0,2).map(world=>({
 id:world.slug,title:world[lang].title,description:world[lang].intro,image:world.image,
 href:worldRoot+world.slug+'/'
}));
const smaller=visibleWorlds.slice(2).map(world=>({
 id:world.slug,title:world[lang].title,description:world[lang].intro,image:world.image,
 href:worldRoot+world.slug+'/'
}));
---
<div class="sp-worlds" style={`--sp-worlds-image:url("${base}/images/spiken-varldar-tankens-hav.webp")`}>
 <section class="sp-worlds-hero">
   <div class="sp-worlds-wrap">
    <p class="sp-worlds-kicker">{t.kicker}</p>
    <h1>{t.first} <em>{t.last}</em></h1>
    <p class="sp-worlds-lead">{t.intro}</p>
    <a class="sp-worlds-cta" href="#upptack">{t.explore} <span aria-hidden="true">↓</span></a>
   </div>
 </section>
 <section class="sp-worlds-content" id="upptack">
  <div class="sp-worlds-wrap">
   <header class="sp-worlds-heading"><p class="sp-worlds-section-label">{t.kicker}</p><h2>{t.sections}</h2><p>{t.direction}</p></header>
   <div class="sp-worlds-main-grid">
    {cards.map(card=><a href={card.href} id={card.id} class="sp-worlds-card" aria-label={card.title+ " – "+t.enter} style={`--world-card:url("${base}/images/${card.image}.webp")`}>
      <div class="sp-worlds-card-inner"><span class="sp-worlds-status">{t.soon}</span><h3>{card.title}</h3><p>{card.description}</p><span class="sp-worlds-enter">{t.enter} <span aria-hidden="true">↗</span></span></div>
    </a>)}
   </div>
   <div class="sp-worlds-secondary">
    {smaller.map(card=><a href={card.href} id={card.id} class="sp-worlds-small" aria-label={card.title+ " – "+t.enter} style={`--world-card:url("${base}/images/${card.image}.webp")`}>
      <div><span class="sp-worlds-status">{t.soon}</span><h3>{card.title}</h3><p>{card.description}</p><span class="sp-worlds-enter">{t.enter} <span aria-hidden="true">↗</span></span></div>
    </a>)}
   </div>
   <div class="sp-worlds-return"><a href={poems}>← {t.back}</a></div>
  </div>
 </section>
</div>
<style>
.sp-worlds{position:relative;isolation:isolate;overflow:hidden;background:#0d0b0b;color:#eee2d8;font-family:Georgia,serif}
.sp-worlds::before{content:"";position:absolute;z-index:-1;pointer-events:none;inset:0 0 auto;height:min(1120px,110vw);min-height:760px;background-image:linear-gradient(90deg,#090808f9 0%,#090808e8 24%,#09080873 53%,#09080814 100%),linear-gradient(180deg,transparent 0%,#0d0b0b17 42%,#0d0b0bad 77%,#0d0b0b 100%),var(--sp-worlds-image);background-position:center,center,center 29%;background-size:cover;background-repeat:no-repeat}
.sp-worlds-wrap{width:min(1320px,calc(100% - 84px));margin:auto}
.sp-worlds-hero{position:relative;display:flex;align-items:end;min-height:535px;background:transparent}
.sp-worlds-hero:before,.sp-worlds-hero:after{display:none}
.sp-worlds-hero .sp-worlds-wrap{padding:130px 0 66px}
.sp-worlds-kicker{font:700 11px Arial,sans-serif;letter-spacing:.24em;color:#e7c7be}
.sp-worlds-hero h1{font:italic 400 clamp(50px,4.8vw,73px)/1.08 Georgia,serif;letter-spacing:-.035em;margin:22px 0 18px}
.sp-worlds-hero h1 em{color:#bf2029}
.sp-worlds-lead{max-width:520px;font:19px/1.65 Georgia,serif;color:#ecd9d1;margin:0}
.sp-worlds-cta{display:inline-flex;gap:24px;align-items:center;padding:13px 21px;background:#921417;border:1px solid #b12d33;color:#fff;font:15px Arial,sans-serif;margin-top:26px}
.sp-worlds-cta:hover{background:#bf2029;color:#fff}
.sp-worlds-content{position:relative;padding:27px 0 75px;background:linear-gradient(180deg,#0d0b0b08 0%,#0d0b0b86 235px,#0d0b0bf4 520px,#0d0b0b 790px)}
.sp-worlds-heading{text-align:center;padding-bottom:22px}
.sp-worlds-heading h2{font:italic 400 clamp(35px,3.7vw,52px)/1.2 Georgia,serif;margin:0}
.sp-worlds-heading p:last-child{font:16px/1.6 Georgia,serif;color:#d5bbb3;margin:13px auto 20px;max-width:610px}
.sp-worlds-section-label{font:700 10px/1.5 Arial,sans-serif;letter-spacing:.18em;color:#cb908b;margin:0 0 17px}
.sp-worlds-main-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
.sp-worlds-card,.sp-worlds-small{position:relative;isolation:isolate;overflow:hidden;border:1px solid #634a42;display:flex;align-items:end;background:#171010;color:#eee2d8;text-decoration:none}
.sp-worlds-card:hover,.sp-worlds-small:hover{border-color:#b87973;color:#fff}
.sp-worlds-card:focus-visible,.sp-worlds-small:focus-visible{outline:2px solid #e6babb;outline-offset:4px}
.sp-worlds-enter{display:inline-flex;align-items:center;gap:18px;margin-top:22px;padding-bottom:6px;border-bottom:1px solid #b85d62;color:#f4d5d0;font:13px/1.5 Arial,sans-serif}
.sp-worlds-card{min-height:310px;scroll-margin-top:40px}
.sp-worlds-card:before,.sp-worlds-small:before{content:"";position:absolute;inset:0;z-index:-1;background-image:linear-gradient(0deg,#0a0708f8 0%,#0a0708b0 39%,#0a07081d 100%),var(--world-card);background-size:cover;background-position:center;transition:transform .35s}
.sp-worlds-card:hover:before,.sp-worlds-small:hover:before{transform:scale(1.05)}
.sp-worlds-card-inner{padding:26px 23px}
.sp-worlds-status{font:10px/1.5 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#e4afa8}
.sp-worlds-card h3,.sp-worlds-small h3{font:italic 400 37px/1.2 Georgia,serif;margin:12px 0 10px}
.sp-worlds-card p,.sp-worlds-small p{font:16px/1.6 Georgia,serif;color:#e4cfca;margin:0}
.sp-worlds-secondary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin-top:13px}
.sp-worlds-small{min-height:190px;padding:25px;scroll-margin-top:30px}
.sp-worlds-small h3{font-size:31px}
.sp-worlds-return{text-align:center;padding-top:35px}
.sp-worlds-return a{font:14px Arial,sans-serif;border-bottom:1px solid #ad343a;padding-bottom:8px}
@media(max-width:900px){.sp-worlds-wrap{width:calc(100% - 36px)}.sp-worlds-main-grid{grid-template-columns:1fr}.sp-worlds-card{min-height:230px}}
@media(max-width:600px){.sp-worlds::before{height:1060px;min-height:0;background-image:linear-gradient(0deg,#0d0b0b 0%,#0d0b0bb8 45%,#0d0b0b35 83%),linear-gradient(90deg,#0908089e,transparent 76%),var(--sp-worlds-image);background-position:center,center,61% top}.sp-worlds-hero{min-height:610px}.sp-worlds-hero .sp-worlds-wrap{padding:245px 0 55px}.sp-worlds-hero h1{font-size:clamp(44px,10.5vw,67px)}.sp-worlds-lead{font-size:17px}.sp-worlds-secondary{grid-template-columns:1fr}.sp-worlds-card{min-height:235px}.sp-worlds-small{min-height:165px}}
@media(prefers-reduced-motion:reduce){.sp-worlds-card:before,.sp-worlds-small:before{transition:none}}
</style>
