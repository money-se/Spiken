---
import '../styles/global.css';
const { title = 'Spiken – Ord under huden', description = 'Dikter om kärlek, sorg, saknad och allt det som inte alltid får sägas högt.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="sv">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="theme-color" content="#151310" />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" /><meta property="og:locale" content="sv_SE" /><meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Spiken" /><meta property="og:image" content={new URL(base + '/images/social-delning.webp', Astro.site).toString()} /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
<title>{title}</title>
</head>
<body>
<a class="skip-link" href="#innehall">Hoppa till innehållet</a>
<header class="site-header spiken-photo-header" style={`--header-art:url("${base}/images/header-bakgrund.webp")`}><div class="wrap header-inner">
<a class="brand" href={base + '/'} aria-label="Spiken – startsidan">
<img class="brand-symbol spiken-brand-image" src={base + '/images/spiken-emblem.webp'} width="34" height="48" alt="" />
<span>SPIKEN<span class="brand-stop">.</span></span></a>
<nav class="main-nav" aria-label="Huvudmeny"><a href={base + '/'}>Hem</a><a href={base + '/dikter/'}>Dikter</a><a href={base + '/om/'}>Om Spiken</a></nav>
<a class="header-link" href={base + '/dikter/'}>Öppna arkivet ↗</a>
</div></header>
<main id="innehall"><slot /></main>
<footer class="site-footer spiken-photo-footer" style={`--footer-art:url("${base}/images/footer-bakgrund.webp")`}><div class="wrap footer-inner"><div><span class="footer-brand">SPIKEN.</span><p>Ord under huden · Dikter från undersidan.</p></div><div class="footer-right"><a href={base + '/dikter/'}>Diktarkiv</a><a href={base + '/om/'}>Om Spiken</a><small>© {new Date().getFullYear()} Spiken. Alla rättigheter förbehållna.</small></div></div></footer>
</body>
</html>
<style>
.spiken-photo-header{background-image:linear-gradient(90deg,rgba(13,7,8,.92),rgba(13,7,8,.75)),var(--header-art);background-size:cover;background-position:center center;position:relative}
.spiken-photo-header .header-inner{position:relative}
.spiken-brand-image{display:block;object-fit:contain;width:34px;height:48px}
.spiken-photo-footer{background-image:linear-gradient(90deg,rgba(12,5,8,.91),rgba(12,5,8,.7)),var(--footer-art);background-size:cover;background-position:center center}
.spiken-photo-footer .footer-inner{min-height:180px;align-items:center}
@media(max-width:700px){.spiken-photo-header{background-position:right center}.spiken-photo-footer{background-position:65% center}}
</style>
