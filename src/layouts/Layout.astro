---
import '../styles/global.css';
import '../styles/spiken-identity.css';
import analytics from '../data/analytics.json';
const { title = 'Spiken – Ord under huden', description = 'Dikter om kärlek, sorg, saknad och allt det som inte alltid får sägas högt.', lang = 'sv', alternatePath = null, socialImage = null, socialImageAlt = null, publishedAt = null, structuredData = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const en = lang === 'en';
const alternateCanonical = alternatePath ? new URL(base + alternatePath, Astro.site).toString() : null;
const urlSwedish = en ? (alternateCanonical || new URL(base + '/', Astro.site).toString()) : canonical;
const urlEnglish = en ? canonical : (alternateCanonical || new URL(base + (Astro.url.pathname.includes('/dikter/') ? '/en/poems/' : '/en/'), Astro.site).toString());
const nav = en ? {home:'Home',poems:'Poems',about:'About Spiken',worlds:'Spiken’s Worlds',archive:'Read poems',privacy:'Privacy',footer:'Words under the skin · Stories from beneath the surface.'} : {home:'Hem',poems:'Dikter',about:'Om Spiken',worlds:'Spikens världar',archive:'Läs dikterna',privacy:'Integritet',footer:'Ord under huden · Dikter från undersidan.'};
const home = base + (en ? '/en/' : '/');
const poems = base + (en ? '/en/poems/' : '/dikter/');
const about = base + (en ? '/en/about/' : '/om/');
const worlds = base + (en ? '/en/worlds/' : '/varldar/');
const privacy = base + (en ? '/en/privacy/' : '/integritet/');
const analyticsEnabled = analytics.enabled && Boolean(analytics.site_token);
const analyticsToken = analyticsEnabled ? analytics.site_token : '';
const ogImage = new URL(socialImage || base + '/images/social-delning.webp', Astro.site).toString();
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="theme-color" content="#151310" />
<link rel="canonical" href={canonical} />
{alternatePath && <><link rel="alternate" hreflang="sv" href={urlSwedish} /><link rel="alternate" hreflang="en" href={urlEnglish} /><link rel="alternate" hreflang="x-default" href={urlSwedish} /></>}
<meta property="og:type" content={publishedAt ? "article" : "website"} /><meta property="og:locale" content={en ? "en_US" : "sv_SE"} /><meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Spiken" /><meta property="og:image" content={ogImage} /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
{socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
<title>{title}</title>
<style>
/* SPIKEN: layoutens gemensamma header, footer och samtyckesdialog.
   Blocken behålls i kaskadordning för kompatibilitet med befintliga sidor. */
.spiken-photo-header{background-color:#10080b;background-image:linear-gradient(90deg,rgba(12,6,8,.93),rgba(12,6,8,.9)),var(--header-art);background-size:cover;background-position:center center;position:relative;isolation:isolate;z-index:30;box-shadow:0 3px 0 rgba(20,7,10,.85)}
.spiken-photo-header .header-inner{position:relative}
.spiken-brand-image{display:block;object-fit:contain;width:34px;height:48px}
.spiken-photo-footer{position:relative;z-index:3;isolation:isolate;background-color:#18090e;background-image:linear-gradient(90deg,rgba(12,5,8,.69),rgba(12,5,8,.48)),var(--footer-art);background-size:cover;background-position:center center;border-top:2px solid #8f343d;box-shadow:0 -18px 65px #07020455}
.spiken-photo-footer .footer-inner{min-height:260px;align-items:center;padding-block:66px}.spiken-photo-footer .footer-brand{font-size:clamp(26px,3.6vw,45px);color:#fff4f0}.spiken-photo-footer .footer-inner p{font-size:14px;color:#ead0c8}.spiken-photo-footer .footer-right a{color:#fff0ed;border-bottom:1px solid #a76b70;padding-bottom:7px}.spiken-photo-footer .footer-right small{color:#d0b1aa}
@media(max-width:700px){.spiken-photo-header{background-position:right center}.spiken-photo-footer{background-position:65% center}}

/* Små justeringar för tydligare signatur och footer. */
.spiken-photo-header .header-inner{min-height:94px}
.spiken-photo-header .brand{font-size:27px;letter-spacing:.17em;gap:14px}
.spiken-photo-header .spiken-brand-image{width:43px;height:60px}
.spiken-photo-header{background-image:linear-gradient(90deg,rgba(12,6,8,.94),rgba(12,6,8,.85)),var(--header-art)}
.spiken-photo-footer{background-image:linear-gradient(90deg,rgba(12,5,8,.75),rgba(12,5,8,.34)),var(--footer-art)}
.spiken-photo-footer .footer-inner{min-height:230px;padding-block:52px}
.spiken-photo-footer .footer-brand{letter-spacing:.17em}
@media(max-width:700px){
.spiken-photo-header .header-inner{min-height:82px}
.spiken-photo-header .brand{font-size:21px;gap:10px}
.spiken-photo-header .spiken-brand-image{width:32px;height:45px}
.spiken-photo-footer .footer-inner{min-height:220px;padding-block:40px}
}

.spiken-consent{position:fixed;left:16px;right:16px;bottom:16px;z-index:99;max-width:680px;margin-inline:auto;padding:19px 22px;background:#1c0d14;color:#f4e6e9;border:1px solid #91515e;box-shadow:0 12px 55px #000b;font:14px/1.6 Arial,sans-serif;border-radius:9px}
.spiken-consent p{margin:0 0 12px}.spiken-consent a{color:#f0bbc7;text-decoration:underline}
.spiken-consent-actions{display:flex;gap:10px;flex-wrap:wrap}
.spiken-consent button{padding:11px 16px;background:#632b3c;border:1px solid #8b5362;color:#fff;cursor:pointer;font:inherit;border-radius:4px}
.spiken-consent button[data-choice="no"]{background:transparent}
.spiken-consent button:focus-visible{outline:2px solid #ffe1e8;outline-offset:3px}
.spiken-consent-settings{font:inherit;color:#fff0ed;background:none;border:none;border-bottom:1px solid #a76b70;padding:0 0 7px;cursor:pointer}
@media(max-width:540px){.spiken-consent{bottom:8px;left:8px;right:8px;padding:14px}.spiken-consent button{flex:1}}

/* Spiken 2.0: anpassad navigation och språkbyte */
.spiken-photo-header{background-color:#16090e;background-image:linear-gradient(90deg,#12070dec,#12070de8),var(--header-art);border-bottom:1px solid #633640}
.spiken-photo-header .header-inner{max-width:1280px;width:min(1280px,calc(100% - 72px));gap:27px;min-height:82px}
.spiken-photo-header .brand{font-size:24px;gap:11px}
.spiken-photo-header .spiken-brand-image{width:32px;height:46px}
.spiken-photo-header .main-nav{gap:25px;margin-left:auto;align-items:center}
.spiken-photo-header .main-nav a{font:13px Arial,sans-serif;white-space:nowrap;color:#eed6d5}
.spiken-header-actions{display:flex;align-items:center;gap:20px}
.spiken-header-actions .header-link{display:none}
.spiken-languages{display:flex;align-items:center;gap:8px;color:#a98e91;font:700 12px Arial,sans-serif}
.spiken-languages a{color:#ad9396;padding:8px 0}
.spiken-languages a[aria-current="page"]{color:#fff0ec;border-bottom:1px solid #d49da5}
.spiken-photo-footer{background-image:linear-gradient(90deg,rgba(15,6,10,.88),rgba(15,6,10,.58)),var(--footer-art)}
.spiken-photo-footer .footer-inner{min-height:200px}
.spiken-photo-footer .footer-right{max-width:560px}
@media(max-width:930px){.spiken-photo-header .header-inner{gap:13px;width:calc(100% - 36px)}.spiken-photo-header .main-nav{gap:14px}.spiken-photo-header .main-nav a{font-size:12px}.spiken-photo-header .brand{font-size:21px}}
@media(max-width:700px){
.spiken-photo-header .header-inner{min-height:0;flex-wrap:wrap;gap:8px;padding:9px 0 13px}
.spiken-photo-header .brand{font-size:20px}
.spiken-photo-header .spiken-brand-image{width:28px;height:40px}
.spiken-header-actions{margin-left:auto}
.spiken-photo-header .main-nav{order:3;width:100%;margin:0;justify-content:space-between;overflow-x:auto;padding:10px 0 2px;gap:13px}
.spiken-photo-header .main-nav a{font-size:12px;flex-shrink:0}
.spiken-photo-footer .footer-inner{align-items:start}
}

/* Endast startsidan: den genomgående bildvärlden tonas naturligt ned i sidfoten. */
body:has(.spiken-simple) .spiken-photo-footer{
  border-top:0;
  box-shadow:none;
  background-color:#160a10;
  background-image:linear-gradient(180deg,#160a10 0%,rgba(22,10,16,.93) 26%,rgba(22,10,16,.75) 63%,rgba(22,10,16,.57) 100%),var(--footer-art);
  background-size:cover;
  background-position:center center;
}
body:has(.spiken-simple) .spiken-photo-footer .footer-inner{
  padding-top:34px;
  padding-bottom:56px;
  min-height:190px;
}
@media(max-width:700px){
  body:has(.spiken-simple) .spiken-photo-footer{background-position:center center}
  body:has(.spiken-simple) .spiken-photo-footer .footer-inner{padding-top:24px;padding-bottom:43px}
}

/* Spiken 3.0: gemensam sidstruktur och footer för samtliga undersidor. */
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)){background:#0d0b0b}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .header-inner{
 width:min(1320px,calc(100% - 84px));
 min-height:72px;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .brand{
 font:italic 400 32px/1 Georgia,'Times New Roman',serif;
 letter-spacing:-.045em;
 gap:8px;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .spiken-brand-image{
 width:28px;height:42px;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .main-nav a{
 font:16px/1.5 Georgia,serif;
 color:#f1e6dc;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .main-nav a:hover{color:#d94b50}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-footer{
 background:#0d0b0b;
 border-top:1px solid #68453e;
 box-shadow:none;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-footer .footer-inner{
 width:min(1320px,calc(100% - 84px));
 min-height:145px;
 padding-block:28px;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-footer .footer-brand{
 font:italic 400 29px Georgia,serif;
 letter-spacing:0;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-footer .footer-right a{
 border-bottom:0;
 color:#d8cac1;
 font:13px Arial,sans-serif;
 padding-bottom:4px;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-footer .footer-right a:hover{color:#f2d3d2}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-footer .footer-inner p{
 font:italic 15px Georgia,serif;color:#d9bbb0
}
@media(max-width:900px){
 body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .header-inner,
 body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-footer .footer-inner{
 width:calc(100% - 36px)}
 body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .main-nav a{font-size:13px}
}
@media(max-width:700px){
 body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .header-inner{padding:9px 0 11px;min-height:0}
 body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .brand{font-size:26px}
 body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-footer .footer-inner{min-height:0;padding-block:32px}
}

/* Spiken 3.x: godkänd signatur och transparent header.
   Headerns slutliga utseende definieras här för alla Spiken 3-sidor. */
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .brand{
  font-family:'Segoe Script','Brush Script MT',Georgia,serif;
  font-size:clamp(29px,2.5vw,41px);
  font-style:italic;
  font-weight:400;
  letter-spacing:-.08em;
  text-transform:none;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .brand .brand-stop{color:#b9212c}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .brand .spiken-brand-image{order:2;width:28px;height:45px}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .brand>span{order:1}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header{
  position:absolute;
  top:0;
  left:0;
  right:0;
  width:100%;
  z-index:40;
  background:transparent !important;
  background-color:transparent !important;
  background-image:none !important;
  border:0 !important;
  box-shadow:none !important;
}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .header-inner{min-height:74px}
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .brand,
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .main-nav a,
body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .spiken-languages a{
  text-shadow:0 1px 7px rgba(0,0,0,.88),0 2px 14px rgba(0,0,0,.55);
}
@media(max-width:700px){
 body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .brand{font-size:29px}
 body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header .header-inner{min-height:0}
 body:has(:is(.spiken-three,.pa-shell,.prv3,.sp-category,.sp-about,.sp-worlds)) .spiken-photo-header{
  background:linear-gradient(180deg,rgba(5,4,5,.34),transparent) !important;
 }
}
</style>






</head>
<body>
<a class="skip-link" href="#innehall">{en ? "Skip to content" : "Hoppa till innehållet"}</a>
<header class="site-header spiken-photo-header" style={`--header-art:url("${base}/images/header-bakgrund.webp")`}><div class="wrap header-inner">
<a class="brand" href={home} aria-label={en ? "Spiken – homepage" : "Spiken – startsidan"}>
<img class="brand-symbol spiken-brand-image" src={base + '/images/spiken-emblem.webp'} width="34" height="48" alt="" />
<span>Spiken<span class="brand-stop">.</span></span></a>
<nav class="main-nav" aria-label={en ? "Main navigation" : "Huvudmeny"}><a href={home}>{nav.home}</a><a href={poems}>{nav.poems}</a><a href={about}>{nav.about}</a><a href={worlds}>{nav.worlds}</a></nav>
<div class="spiken-header-actions"><a class="header-link" href={poems}>{nav.archive} ↗</a><nav class="spiken-languages" aria-label={en ? "Language" : "Språk"}><a href={urlSwedish} lang="sv" aria-current={!en ? "page" : undefined}>SV</a><span aria-hidden="true">/</span><a href={urlEnglish} lang="en" aria-current={en ? "page" : undefined}>EN</a></nav></div>
</div></header>
<main id="innehall"><slot /></main>
<footer id="sidfot" class="site-footer spiken-photo-footer" style={`--footer-art:url("${base}/images/footer-bakgrund.webp")`}><div class="wrap footer-inner"><div><span class="footer-brand">SPIKEN.</span><p>{nav.footer}</p></div><div class="footer-right"><a href={poems}>{nav.poems}</a><a href={worlds}>{nav.worlds}</a><a href={about}>{nav.about}</a><a href={privacy}>{nav.privacy}</a>{analyticsEnabled && <button type="button" class="spiken-consent-settings" id="spiken-consent-settings">{en ? "Analytics settings" : "Statistikinställningar"}</button>}<small>© {new Date().getFullYear()} Spiken.</small></div></div></footer>

{analyticsEnabled && <div id="spiken-consent" class="spiken-consent" role="region" aria-label={en ? 'Optional analytics preferences' : 'Val för frivillig statistik'} hidden>
  <p>{en ? 'Would you like to help Spiken improve the reading experience? We only load optional Cloudflare analytics if you consent.' : 'Vill du hjälpa Spiken att förbättra läsupplevelsen? Vi kan samla in enkel webbstatistik med Cloudflare, men endast om du godkänner det.'} <a href={privacy}>{en ? 'Read our privacy information' : 'Läs om integritet'}</a>.</p>
  <div class="spiken-consent-actions"><button type="button" data-choice="yes">{en ? 'Yes, allow analytics' : 'Ja, tillåt statistik'}</button><button type="button" data-choice="no">{en ? 'No, thanks' : 'Nej tack'}</button></div>
</div>}
{analyticsEnabled && <script is:inline define:vars={{ analyticsToken }}>
  (function () {
    const key = 'spiken-analytics-consent-v1';
    const panel = document.getElementById('spiken-consent');
    const settings = document.getElementById('spiken-consent-settings');
    function saved() { try { return window.localStorage.getItem(key); } catch (_) { return null; } }
    function save(value) { try { window.localStorage.setItem(key,value); } catch (_) {} }
    function activate() {
      if (document.querySelector('[data-spiken-cloudflare]')) return;
      const script = document.createElement('script');
      script.defer = true;
      script.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      script.dataset.cfBeacon = JSON.stringify({token:analyticsToken});
      script.dataset.spikenCloudflare = '1';
      document.head.appendChild(script);
    }
    const existing = saved();
    if (existing === 'yes') activate();
    else if (existing !== 'no' && panel) panel.hidden = false;
    panel?.querySelectorAll('[data-choice]').forEach(button => button.addEventListener('click',function () {
      const value = button.dataset.choice;
      save(value);
      if (panel) panel.hidden = true;
      if (value === 'yes') activate();
      else if (document.querySelector('[data-spiken-cloudflare]')) window.location.reload();
    }));
    settings?.addEventListener('click',function(){ if (panel) panel.hidden = false; });
  })();
</script>}
</body>
</html>
