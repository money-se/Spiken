---
import '../styles/global.css';
const { title = 'Spiken – Det förbjudna arkivet', description = 'Dikter om kärlek, sorg, saknad och allt det som inte alltid får sägas högt.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="sv">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="theme-color" content="#151310" />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" /><meta property="og:locale" content="sv_SE" /><meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Spiken" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
<title>{title}</title>
</head>
<body>
<a class="skip-link" href="#innehall">Hoppa till innehållet</a>
<header class="site-header"><div class="wrap header-inner">
<a class="brand" href={base + '/'} aria-label="Spiken – startsidan">
<svg class="brand-symbol" aria-hidden="true" viewBox="0 0 48 56" fill="none"><path d="M25 53V21M18 32 25 29 32 32M23 46H27" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M25 12c-7-15-16-6-9 1-14-4-14 10-2 10-8 10 7 17 11 4 4 13 19 6 11-4 12 0 12-14-2-10 7-7-2-16-9-1Z" stroke="currentColor" stroke-width="1.25"/><circle cx="25" cy="18" r="4" fill="#a64e40"/></svg>
<span>SPIKEN<span class="brand-stop">.</span></span></a>
<nav class="main-nav" aria-label="Huvudmeny"><a href={base + '/'}>Hem</a><a href={base + '/dikter/'}>Dikter</a><a href={base + '/om/'}>Om Spiken</a></nav>
<a class="header-link" href={base + '/dikter/'}>Öppna arkivet ↗</a>
</div></header>
<main id="innehall"><slot /></main>
<footer class="site-footer"><div class="wrap footer-inner"><div><span class="footer-brand">SPIKEN.</span><p>Ord under huden · Dikter från undersidan.</p></div><div class="footer-right"><a href={base + '/dikter/'}>Diktarkiv</a><a href={base + '/om/'}>Om Spiken</a><small>© {new Date().getFullYear()} Spiken. Alla rättigheter förbehållna.</small></div></div></footer>
</body>
</html>